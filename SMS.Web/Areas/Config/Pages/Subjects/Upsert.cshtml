@page "{id:guid?}"
@model SMS.Web.Areas.Config.Pages.Subjects.UpsertModel
@{
    ViewData["PageTitle"] = Model.subject.Code != null ? "Edit Subject" : "Add Subject";
    ViewData["PageSubTitle"] = "Create or modify a subject";
}

<form method="post" class="form-compact">
    <div class="form-card">
        <div class="card-body">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input type="hidden" asp-for="subject.Id" />

            <!-- ===== SUBJECT DETAILS ===== -->
            <div class="form-section-title">
                <i class="fa-solid fa-book"></i> Subject Details
            </div>

            <div class="form-grid-2" style="margin-bottom: 1.5rem;">

                <div class="form-group">
                    <label class="form-label" asp-for="subject.Name">
                        Subject Name <span class="required">*</span>
                    </label>
                    <input asp-for="subject.Name" class="form-control" placeholder="e.g. Mathematics" required />
                    <span asp-validation-for="subject.Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="subject.Code">
                        Subject Code <span class="required">*</span>
                    </label>
                    <input asp-for="subject.Code" class="form-control" placeholder="e.g. MATH" required />
                    <span asp-validation-for="subject.Code" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label class="form-label" asp-for="subject.CategoryId">
                        Category <span class="required">*</span>
                    </label>
                    <select asp-for="subject.CategoryId" asp-items="Model.Categories" class="form-control" required>
                        <option value="">— Select category —</option>
                    </select>
                    <span asp-validation-for="subject.CategoryId" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card-footer">
           
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i>
                @(Model.subject.Code != null ? "Save Changes" : "Create Subject")
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}