@page
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@model SMS.Web.Areas.Config.Pages.Subjects.IndexModel
@{
    ViewData["Title"] = "Subjects";
    ViewData["PageTitle"] = "Subjects";
    ViewData["PageSubTitle"] = "Manage subjects taught in the school";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.CreateSubjects))
    {
        <a asp-page="./Upsert" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create
        </a>
    }
}

<div class="table-card">

    <div class="table-count">
        <i class="fa-solid fa-list-ul me-2"></i>
        Total: <strong>@Model.Pagination.TotalCount</strong>
        @(Model.Pagination.TotalCount == 1 ? "subject" : "subjects")
    </div>

    <form method="get" class="table-toolbar" id="filterForm">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" asp-for="SearchTerm"
                   class="search-input"
                   placeholder="Search by name or code..."
                   id="searchInput"
                   autocomplete="off" />
        </div>
        <div class="filter-wrapper">
            <select asp-for="CategoryFilter" class="filter-dropdown" id="categoryFilter">
                <option value="">All Categories</option>
                @foreach (var c in EnumExtensions.AllSubjectCategories())
                {
                    <option value="@((int)c)">@c.ToDisplayName()</option>
                }
            </select>
        </div>
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="PageNumber" value="1" id="pageNumberHidden" />
    </form>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>SUB ID</th>
                <th>Code</th>
                <th>Name</th>
                <th>Category</th>
                <th>Created By</th>
                <th>Date Created</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Subjects.Any())
            {
                @foreach (var s in Model.Subjects)
                {
                    <tr>
                        <td>
                            <a asp-area="Config"
                               asp-page="/Subjects/Details"
                               asp-route-id="@s.Id"
                               class="reg-link">
                                @s.SubjectNumber
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </td>
                        <td><span class="info-value-mono">@s.Code</span></td>
                        <td>@s.Name</td>
                        <td>@(((SubjectCategory)s.CategoryId).ToDisplayName())</td>
                        <td>
                            @if (Model.CreatorEmails.TryGetValue(s.CreatorId, out var email))
                            {
                                @email
                            }
                            else
                            {
                                <span class="sponsor-empty">System Generated</span>
                            }
                        </td>
                        <td>@s.CreationDate.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="empty-state">No subjects found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" />
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('filterForm');
            const searchInput = document.getElementById('searchInput');
            const categoryFilter = document.getElementById('categoryFilter');
            const pageNumberHidden = document.getElementById('pageNumberHidden');
            if (!form || !searchInput || !categoryFilter) return;

            let debounceTimer = null;
            const DEBOUNCE_MS = 400;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    if (pageNumberHidden) pageNumberHidden.value = '1';
                    form.submit();
                }, DEBOUNCE_MS);
            });

            categoryFilter.addEventListener('change', function () {
                if (pageNumberHidden) pageNumberHidden.value = '1';
                form.submit();
            });

            if (searchInput.value) {
                searchInput.focus();
                const len = searchInput.value.length;
                searchInput.setSelectionRange(len, len);
            }
        })();
    </script>
}