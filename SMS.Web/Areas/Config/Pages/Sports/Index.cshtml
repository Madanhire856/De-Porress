@page
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@model SMS.Web.Areas.Config.Pages.Sports.IndexModel
@{
    ViewData["Title"] = "Sports";
    ViewData["PageTitle"] = "Sports";
    ViewData["PageSubTitle"] = "Manage school sports and their coaches";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.CreateSports))
    {
        <a asp-page="./Upsert" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create
        </a>
    }
}

<div class="table-card">

    <div class="table-count">
        <i class="fa-solid fa-list-ul me-2"></i>
        Total: <strong>@Model.Pagination.TotalCount</strong>
        @(Model.Pagination.TotalCount == 1 ? "sport" : "sports")
    </div>

    <form method="get" class="table-toolbar" id="filterForm">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" asp-for="SearchTerm"
                   class="search-input"
                   placeholder="Search by sport name..."
                   id="searchInput"
                   autocomplete="off" />
        </div>
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="PageNumber" value="1" id="pageNumberHidden" />
    </form>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>SPT ID</th>
                <th>Name</th>
                <th>Coaches</th>
                <th>Created By</th>
                <th>Date Created</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Sports.Any())
            {
                @foreach (var s in Model.Sports)
                {
                    var summary = Model.TeacherSummaries.TryGetValue(s.Id, out var ts) ? ts : null;

                    <tr>
                        <td>
                            <a asp-area="Config"
                               asp-page="/Sports/Details"
                               asp-route-id="@s.Id"
                               class="reg-link">
                                @s.SportNumber
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </td>
                        <td>@s.Name</td>
                        <td>
                            @if (summary == null || summary.TotalCount == 0)
                            {
                                <span class="sponsor-empty">No coaches</span>
                            }
                            else if (!string.IsNullOrEmpty(summary.CoachName))
                            {
                                <span>@summary.CoachName</span>
                                @if (summary.AdditionalCount > 0)
                                {
                                    <span class="sponsor-empty"> +@summary.AdditionalCount more</span>
                                }
                            }
                            else
                            {
                                <span>@summary.TotalCount @(summary.TotalCount == 1 ? "coach" : "coaches")</span>
                                <span class="sponsor-empty"> (no lead coach)</span>
                            }
                        </td>
                        <td>
                            @if (Model.CreatorEmails.TryGetValue(s.CreatorId, out var email))
                            {
                                @email
                            }
                            else
                            {
                                <span class="sponsor-empty">System Generated</span>
                            }
                        </td>
                        <td>@s.CreationDate.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="empty-state">No sports found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" />
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('filterForm');
            const searchInput = document.getElementById('searchInput');
            const pageNumberHidden = document.getElementById('pageNumberHidden');
            if (!form || !searchInput) return;

            let debounceTimer = null;
            const DEBOUNCE_MS = 400;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    if (pageNumberHidden) pageNumberHidden.value = '1';
                    form.submit();
                }, DEBOUNCE_MS);
            });

            if (searchInput.value) {
                searchInput.focus();
                const len = searchInput.value.length;
                searchInput.setSelectionRange(len, len);
            }
        })();
    </script>
}