@page
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@model SMS.Web.Areas.Config.Pages.Grades.IndexModel
@{
    ViewData["Title"] = "Grades";
    ViewData["PageTitle"] = "Grades";
    ViewData["PageSubTitle"] = "Manage grade levels across the school";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.CreateGrades))
    {
        <a asp-page="./Upsert" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create
        </a>
    }
}

<div class="table-card">

    <div class="table-count">
        <i class="fa-solid fa-list-ul me-2"></i>
        Total: <strong>@Model.Pagination.TotalCount</strong>
        @(Model.Pagination.TotalCount == 1 ? "grade" : "grades")
    </div>

    <form method="get" class="table-toolbar" id="filterForm">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" asp-for="SearchTerm"
                   class="search-input"
                   placeholder="Search by grade name..."
                   id="searchInput"
                   autocomplete="off" />
        </div>
        <div class="filter-wrapper">
            <select asp-for="GradeLevelFilter" class="filter-dropdown" id="levelFilter">
                <option value="">All Levels</option>
                @foreach (var lvl in EnumExtensions.AllGradeLevels())
                {
                    <option value="@((int)lvl)">@lvl.ToDisplayName()</option>
                }
            </select>
        </div>
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="PageNumber" value="1" id="pageNumberHidden" />
    </form>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>GRD ID</th>
                <th>Name</th>
                <th>Level</th>
                <th>Classes</th>
                <th>Created By</th>
                <th>Date Created</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Grades.Any())
            {
                @foreach (var g in Model.Grades)
                {
                    var classCount = Model.ClassCounts.TryGetValue(g.Id, out var c) ? c : 0;

                    <tr>
                        <td>
                            <a asp-area="Config"
                               asp-page="/Grades/Details"
                               asp-route-id="@g.Id"
                               class="reg-link">
                                @g.GradeNumber
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </td>
                        <td>@g.Name</td>
                        <td>@(((GradeLevel)g.GradeLevelId).ToDisplayName())</td>
                        <td>@classCount</td>
                        <td>
                            @if (Model.CreatorEmails.TryGetValue(g.CreatorId, out var email))
                            {
                                @email
                            }
                            else
                            {
                                <span class="sponsor-empty">System Generated</span>
                            }
                        </td>
                        <td>@g.CreationDate.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="empty-state">No grades found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" />
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('filterForm');
            const searchInput = document.getElementById('searchInput');
            const levelFilter = document.getElementById('levelFilter');
            const pageNumberHidden = document.getElementById('pageNumberHidden');
            if (!form || !searchInput) return;

            let debounceTimer = null;
            const DEBOUNCE_MS = 400;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    if (pageNumberHidden) pageNumberHidden.value = '1';
                    form.submit();
                }, DEBOUNCE_MS);
            });

            if (levelFilter) {
                levelFilter.addEventListener('change', function () {
                    if (pageNumberHidden) pageNumberHidden.value = '1';
                    form.submit();
                });
            }

            if (searchInput.value) {
                searchInput.focus();
                const len = searchInput.value.length;
                searchInput.setSelectionRange(len, len);
            }
        })();
    </script>
}