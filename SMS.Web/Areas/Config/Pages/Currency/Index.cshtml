@page
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@model SMS.Web.Areas.Config.Pages.Currency.IndexModel
@{
    ViewData["Title"] = "Currencies";
    ViewData["PageTitle"] = "Currencies";
    ViewData["PageSubTitle"] = "Manage system currencies";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.CreateCurrencies))
    {
        <a asp-page="./Upsert" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create
        </a>
    }
}

<div class="table-card">

    <div class="table-count">
        <i class="fa-solid fa-list-ul me-2"></i>
        Total: <strong>@Model.Pagination.TotalCount</strong>
        @(Model.Pagination.TotalCount == 1 ? "currency" : "currencies")
    </div>

    <form method="get" class="table-toolbar" id="filterForm">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" asp-for="SearchTerm"
                   class="search-input"
                   placeholder="Search by code or name..."
                   id="searchInput"
                   autocomplete="off" />
        </div>
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="PageNumber" value="1" id="pageNumberHidden" />
    </form>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Symbol</th>
                <th>Created By</th>
                <th>Date Created</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Currencies.Any())
            {
                @foreach (var c in Model.Currencies)
                {
                    <tr>
                        <td>
                            <a asp-area="Config"
                               asp-page="/Currency/Details"
                               asp-route-code="@c.Code"
                               class="reg-link">
                                @c.Code
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </td>
                        <td>@c.Name</td>
                        <td><span class="info-value-mono">@c.Symbol</span></td>
                        <td>
                            @if (c.CreatorId.HasValue && Model.CreatorEmails.TryGetValue(c.CreatorId.Value, out var email))
                            {
                                @email
                            }
                            else
                            {
                                <span class="sponsor-empty">System Generated</span>
                            }
                        </td>
                        <td>@(c.CreationDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="empty-state">No currencies found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" />
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('filterForm');
            const searchInput = document.getElementById('searchInput');
            const pageNumberHidden = document.getElementById('pageNumberHidden');
            if (!form || !searchInput) return;

            let debounceTimer = null;
            const DEBOUNCE_MS = 400;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    if (pageNumberHidden) pageNumberHidden.value = '1';
                    form.submit();
                }, DEBOUNCE_MS);
            });

            if (searchInput.value) {
                searchInput.focus();
                const len = searchInput.value.length;
                searchInput.setSelectionRange(len, len);
            }
        })();
    </script>
}