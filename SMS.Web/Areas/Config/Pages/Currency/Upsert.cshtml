@page "{code?}"
@model SMS.Web.Areas.Config.Pages.Currency.UpsertModel
@{
    ViewData["PageTitle"] = string.IsNullOrEmpty(Model.currency.Code) || HttpContext.Request.RouteValues.ContainsKey("code")
        ? "Edit Currency"
        : "Add Currency";
    ViewData["PageSubTitle"] = "Create or modify a currency";
}

<form method="post" class="form-compact">
    <div class="form-card">
        <div class="card-body">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- ===== CURRENCY DETAILS ===== -->
            <div class="form-section-title">
                <i class="fa-solid fa-coins"></i> Currency Details
            </div>

            <div class="form-grid-2" style="margin-bottom: 1.5rem;">

                <div class="form-group">
                    <label class="form-label" asp-for="currency.Code">
                        Currency Code <span class="required">*</span>
                    </label>
                    <input asp-for="currency.Code"
                           class="form-control"
                           placeholder="e.g. USD"
                           readonly="@(HttpContext.Request.RouteValues.ContainsKey("code"))"
                           required />
                    <span asp-validation-for="currency.Code" class="text-danger"></span>
                    <small style="color: var(--sms-text-muted); font-size: 0.75rem;">
                        3-letter ISO code (e.g. USD, ZWL, ZAR).
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="currency.Name">
                        Currency Name <span class="required">*</span>
                    </label>
                    <input asp-for="currency.Name" class="form-control" placeholder="e.g. United States Dollar" required />
                    <span asp-validation-for="currency.Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="currency.Symbol">
                        Currency Symbol <span class="required">*</span>
                    </label>
                    <input asp-for="currency.Symbol" class="form-control" placeholder="e.g. $" required />
                    <span asp-validation-for="currency.Symbol" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card-footer">
           
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i>
                Save Currency
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}