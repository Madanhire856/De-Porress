@page
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@model SMS.Web.Areas.Config.Pages.Houses.IndexModel
@{
    ViewData["Title"] = "Houses";
    ViewData["PageTitle"] = "Houses";
    ViewData["PageSubTitle"] = "Manage school houses and their masters";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.CreateHouses))
    {
        <a asp-page="./Upsert" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create
        </a>
    }
}

<div class="table-card">

    <div class="table-count">
        <i class="fa-solid fa-list-ul me-2"></i>
        Total: <strong>@Model.Pagination.TotalCount</strong>
        @(Model.Pagination.TotalCount == 1 ? "house" : "houses")
    </div>

    <form method="get" class="table-toolbar" id="filterForm">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" asp-for="SearchTerm"
                   class="search-input"
                   placeholder="Search by house name..."
                   id="searchInput"
                   autocomplete="off" />
        </div>
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="PageNumber" value="1" id="pageNumberHidden" />
    </form>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>HSE ID</th>
                <th>Name</th>
                <th>Color</th>
                <th>House Master</th>
                <th>Created By</th>
                <th>Date Created</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Houses.Any())
            {
                @foreach (var h in Model.Houses)
                {
                    var masterName = Model.MasterNames.TryGetValue(h.MasterId, out var m) ? m : "—";

                    <tr>
                        <td>
                            <a asp-area="Config"
                               asp-page="/Houses/Details"
                               asp-route-id="@h.Id"
                               class="reg-link">
                                @h.HouseNumber
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </td>
                        <td>@h.Name</td>
                        <td>
                            <span style="display:inline-flex; align-items:center; gap:0.4rem;">
                                <span style="display:inline-block; width:14px; height:14px; border-radius:3px; border:1px solid var(--sms-border); background-color:@h.Color;"></span>
                                <span class="info-value-mono">@h.Color</span>
                            </span>
                        </td>
                        <td>@masterName</td>
                        <td>
                            @if (Model.CreatorEmails.TryGetValue(h.CreatorId, out var email))
                            {
                                @email
                            }
                            else
                            {
                                <span class="sponsor-empty">System Generated</span>
                            }
                        </td>
                        <td>@h.CreationDate.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="empty-state">No houses found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" />
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('filterForm');
            const searchInput = document.getElementById('searchInput');
            const pageNumberHidden = document.getElementById('pageNumberHidden');
            if (!form || !searchInput) return;

            let debounceTimer = null;
            const DEBOUNCE_MS = 400;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    if (pageNumberHidden) pageNumberHidden.value = '1';
                    form.submit();
                }, DEBOUNCE_MS);
            });

            if (searchInput.value) {
                searchInput.focus();
                const len = searchInput.value.length;
                searchInput.setSelectionRange(len, len);
            }
        })();
    </script>
}