@page
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@model SMS.Web.Areas.Config.Pages.Villages.IndexModel
@{
    ViewData["Title"] = "Villages";
    ViewData["PageTitle"] = "Villages";
    ViewData["PageSubTitle"] = "Manage villages and their traditional leadership";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.CreateVillages))
    {
        <a asp-page="./Upsert" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create
        </a>
    }
}

<div class="table-card">

    <div class="table-count">
        <i class="fa-solid fa-list-ul me-2"></i>
        Total: <strong>@Model.Pagination.TotalCount</strong>
        @(Model.Pagination.TotalCount == 1 ? "village" : "villages")
    </div>

    <form method="get" class="table-toolbar" id="filterForm">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" asp-for="SearchTerm"
                   class="search-input"
                   placeholder="Search by village, headman, or chief..."
                   id="searchInput"
                   autocomplete="off" />
        </div>
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="PageNumber" value="1" id="pageNumberHidden" />
    </form>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>VLG ID</th>
                <th>Name</th>
                <th>Headman</th>
                <th>Chief</th>
                <th>Students</th>
                <th>Created By</th>
                <th>Date Created</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Villages.Any())
            {
                @foreach (var v in Model.Villages)
                {
                    var studentCount = Model.StudentCounts.TryGetValue(v.Id, out var sc) ? sc : 0;

                    <tr>
                        <td>
                            <a asp-area="Config"
                               asp-page="/Villages/Details"
                               asp-route-id="@v.Id"
                               class="reg-link">
                                @v.VillageNumber
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </td>
                        <td>@v.Name</td>
                        <td>@v.Headman</td>
                        <td>@v.Chief</td>
                        <td>@studentCount</td>
                        <td>
                            @if (Model.CreatorEmails.TryGetValue(v.CreatorId, out var email))
                            {
                                @email
                            }
                            else
                            {
                                <span class="sponsor-empty">System Generated</span>
                            }
                        </td>
                        <td>@v.CreationDate.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="empty-state">No villages found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" />
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('filterForm');
            const searchInput = document.getElementById('searchInput');
            const pageNumberHidden = document.getElementById('pageNumberHidden');
            if (!form || !searchInput) return;

            let debounceTimer = null;
            const DEBOUNCE_MS = 400;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    if (pageNumberHidden) pageNumberHidden.value = '1';
                    form.submit();
                }, DEBOUNCE_MS);
            });

            if (searchInput.value) {
                searchInput.focus();
                const len = searchInput.value.length;
                searchInput.setSelectionRange(len, len);
            }
        })();
    </script>
}