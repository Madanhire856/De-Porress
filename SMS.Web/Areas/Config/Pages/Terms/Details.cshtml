@page "{id:guid}"
@model SMS.Web.Areas.Config.Pages.Terms.DetailsModel
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Term Details";
    ViewData["PageTitle"] = "Term Details";
    ViewData["PageSubTitle"] = $"Viewing details for {Model.TermVM.Label}";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.EditTerms))
    {
        <a asp-page="./Upsert" asp-route-id="@Model.TermVM.Id" class="btn btn-secondary">
            <i class="fa-solid fa-pen-to-square"></i> Edit
        </a>
    }
    <a asp-page="./Index" class="btn btn-ghost">
        <i class="fa-solid fa-arrow-left"></i> Back to List
    </a>
}

<div class="details-compact">
    <div class="details-single">

        <!-- ===== PROFILE HEADER ===== -->
        <div class="profile-card">
            <div class="profile-avatar">
                <i class="fa-solid fa-calendar"></i>
            </div>
            <div class="profile-info">
                <h2 class="profile-name">@Model.TermVM.Label</h2>
                <div class="profile-meta">
                    <span class="info-value-mono">@Model.TermVM.TermDisplayId</span>
                   
                </div>
            </div>
        </div>

        <!-- ===== TWO-COLUMN BODY ===== -->
        <div class="info-grid">

            <!-- LEFT: Term Information -->
            <div class="info-column">
                <div class="info-column-header">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Term Information</span>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-hashtag"></i> TRM ID
                    </div>
                    <div class="info-value info-value-mono">@Model.TermVM.TermDisplayId</div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-tag"></i> Name
                    </div>
                    <div class="info-value">
                        @if (!string.IsNullOrWhiteSpace(Model.TermVM.Name))
                        {
                            @Model.TermVM.Name
                        }
                        else
                        {
                            <span class="sponsor-empty">—</span>
                        }
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-calendar"></i> Academic Year
                    </div>
                    <div class="info-value">@Model.TermVM.AcademicYear</div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-list-ol"></i> Term
                    </div>
                    <div class="info-value">Term @Model.TermVM.TermNumber</div>
                </div>
            </div>

            <!-- RIGHT: Dates & Metadata -->
            <div class="info-column">
                <div class="info-column-header">
                    <i class="fa-solid fa-clipboard-list"></i>
                    <span>Dates &amp; Metadata</span>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-play"></i> Start Date
                    </div>
                    <div class="info-value">@Model.TermVM.StartDate?.ToString("dd MMM yyyy")</div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-stop"></i> End Date
                    </div>
                    <div class="info-value">@Model.TermVM.EndDate?.ToString("dd MMM yyyy")</div>
                </div>

            </div>

        </div>

        <!-- ===== CARD FOOTER ===== -->
        <div class="info-card-footer">
            <div>
                <span>Created By:</span>
                <strong>@(string.IsNullOrEmpty(Model.CreatorEmail) ? "System Generated" : Model.CreatorEmail)</strong>
            </div>
            <div>
                <span>Created On:</span>
                <strong>@Model.TermVM.CreationDate.ToString("dd MMM yyyy, HH:mm")</strong>
            </div>
        </div>

    </div>
</div>