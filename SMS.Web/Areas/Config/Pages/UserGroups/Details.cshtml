@page "{id:guid}"
@model SMS.Web.Areas.Config.Pages.UserGroups.DetailsModel
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "User Group Details";
    ViewData["PageTitle"] = "User Group Details";
    ViewData["PageSubTitle"] = $"Viewing details for {Model.UserGroup.Name}";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.EditUserGroups))
    {
        <a asp-page="./Upsert" asp-route-id="@Model.UserGroup.Id" class="btn btn-secondary">
            <i class="fa-solid fa-pen-to-square"></i> Edit
        </a>
    }
    <a asp-page="./Index" class="btn btn-primary">
        <i class="fa-solid fa-arrow-left"></i> Back to List
    </a>
}

<div class="details-compact">
    <div class="details-single">

        <!-- ===== PROFILE HEADER ===== -->
        <div class="profile-card">
            <div class="profile-avatar">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="profile-info">
                <h2 class="profile-name">@Model.UserGroup.Name</h2>
                <div class="profile-meta">
                    <span>Created @Model.UserGroup.CreationDate.ToString("dd MMM yyyy")</span>
                    @if (Model.UserGroup.Creator != null)
                    {
                        <span class="meta-sep">·</span>
                        <span>
                            by @(!string.IsNullOrEmpty(Model.UserGroup.Creator.Name)
                                                                ? Model.UserGroup.Creator.Name
                                                                : Model.UserGroup.Creator.Email)
                        </span>
                    }
                </div>
                <div class="profile-badges">
                    <span class="status-badge status-active">Active</span>
                    @if (Model.TotalRightsGranted > 0)
                    {
                        <span class="status-badge status-count">
                            <i class="fa-solid fa-key"></i> @Model.TotalRightsGranted rights
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- ===== TWO-COLUMN BODY ===== -->
        <div class="info-grid">

            <!-- LEFT: Group Information -->
            <div class="info-column">
                <div class="info-column-header">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Group Information</span>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-tag"></i> Group Name
                    </div>
                    <div class="info-value">@Model.UserGroup.Name</div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-align-left"></i> Description
                    </div>
                    <div class="info-value">
                        @if (string.IsNullOrEmpty(Model.UserGroup.Description))
                        {
                            <span class="sponsor-empty">—</span>
                        }
                        else
                        {
                            @Model.UserGroup.Description
                        }
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-envelope"></i> Created By
                    </div>
                    <div class="info-value">
                        @if (Model.UserGroup.Creator != null)
                        {
                            @(Model.UserGroup.Creator.Email)
                        }
                        else
                        {
                            <span class="sponsor-empty">System Generated</span>
                        }
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-label">
                        <i class="fa-solid fa-calendar"></i> Creation Date
                    </div>
                    <div class="info-value">@Model.UserGroup.CreationDate.ToString("dd MMM yyyy, HH:mm")</div>
                </div>
            </div>

            <!-- RIGHT: Access Rights -->
            <div class="info-column">
                <div class="info-column-header">
                    <i class="fa-solid fa-key"></i>
                    <span>Access Rights</span>
                    <span class="info-card-badge">@Model.TotalRightsGranted / @Model.TotalPossibleRights</span>
                </div>

                @if (Model.TotalRightsGranted == 0)
                {
                    <div class="info-row">
                        <div class="info-label">
                            <i class="fa-solid fa-ban"></i> Rights
                        </div>
                        <div class="info-value">
                            <span class="sponsor-empty">No rights assigned to this group</span>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var cat in Model.RightsByCategory)
                    {
                        <div class="rights-block">
                            <div class="rights-block-header">
                                <i class="fa-solid @cat.Icon"></i>
                                <span>@cat.Title</span>
                                <span class="rights-block-count @(cat.Granted.Count == 0 ? "is-empty" : "")">
                                    @cat.Granted.Count / @cat.Total
                                </span>
                            </div>
                            @if (cat.Granted.Count > 0)
                            {
                                <div class="rights-pills">
                                    @foreach (var r in cat.Granted)
                                    {
                                        <span class="right-pill">
                                            <i class="fa-solid fa-check"></i> @r
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>

        </div>

        <!-- ===== CARD FOOTER ===== -->
        <div class="info-card-footer">
            <div>
                <span>Created By:</span>
                <strong>
                    @if (Model.UserGroup.Creator != null)
                    {
                        @(!string.IsNullOrEmpty(Model.UserGroup.Creator.Name)
                            ? Model.UserGroup.Creator.Name
                            : Model.UserGroup.Creator.Email)
                    }
                    else
                    {
                        <text>System Generated</text>
                    }
                </strong>
            </div>
            <div>
                <span>Created On:</span>
                <strong>@Model.UserGroup.CreationDate.ToString("dd MMM yyyy, HH:mm")</strong>
            </div>
        </div>

    </div>
</div>