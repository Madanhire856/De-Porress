@page
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@model SMS.Web.Areas.Config.Pages.UserGroups.IndexModel
@{
    ViewData["Title"] = "User Groups";
    ViewData["PageTitle"] = "User Groups";
    ViewData["PageSubTitle"] = "Manage system roles and permissions";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.CreateUserGroups))
    {
        <a asp-page="./Upsert" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create
        </a>
    }
}

<div class="table-card">


    <div class="table-count">
        <i class="fa-solid fa-list-ul me-2"></i>
        Total: <strong>@Model.Pagination.TotalCount</strong>
        @(Model.Pagination.TotalCount == 1 ? "user group" : "user groups")
    </div>

    <form method="get" class="table-toolbar">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" asp-for="SearchTerm" class="search-input" placeholder="Search user groups..." />
        </div>
        <div class="filter-wrapper">
            <select asp-for="StatusFilter" class="filter-dropdown">
                <option value="All">All Statuses</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
        <input type="hidden" asp-for="PageSize" />
    </form>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>UG ID</th>
                <th>Group Name</th>
                <th>Description</th>
                <th>Created By</th>
                <th>Date Created</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.UserGroups.Any())
            {
                @foreach (var group in Model.UserGroups)
                {
                    <tr>
                        <td>
                            <a asp-area="Config"
                               asp-page="/UserGroups/Details"
                               asp-route-id="@group.Id"
                               class="reg-link">
                                @group.UserGroupNumber
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </td>
                        <td>@group.Name</td>
                        <td>@(string.IsNullOrEmpty(group.Description) ? "—" : group.Description)</td>
                        <td>@(group.Creator?.Email ?? "—")</td>
                        <td>@group.CreationDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="status-badge status-active">Active</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="empty-state">No user groups found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" />
</div>