@page
@model SMS.Web.Areas.Config.Pages.UserGroups.IndexModel
@{
    ViewData["Title"] = "User Groups";
    ViewData["PageTitle"] = "User Groups";
    ViewData["PageSubTitle"] = "Manage system roles and permissions";
}

@section actionbar {
    <a asp-page="./Upsert" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Create
    </a>
}

<div class="table-card">
    <!-- Table Toolbar (Search & Filter) -->
    <form method="get" class="table-toolbar">
        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" asp-for="SearchTerm" class="search-input" placeholder="Search user groups..." />
        </div>
        <div class="filter-wrapper">
            <select asp-for="StatusFilter" class="filter-dropdown">
                <option value="All">All Statuses</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
        <input type="hidden" asp-for="PageSize" />
    </form>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>Group Name</th>
                <th>Description</th>
                <th>Created By</th>
                <th>Date Created</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.UserGroups != null && Model.UserGroups.Any())
            {
                @foreach (var group in Model.UserGroups)
                {
                    <tr>
                        <td>
                            <a asp-area="Config" asp-page="/UserGroups/Details" asp-route-id="@group.Id" class="reg-link">
                                @group.Name
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(group.Description))
                            {
                                <span class="sponsor-empty">—</span>
                            }
                            else
                            {
                                @group.Description
                            }
                        </td>
                        <td>
                            @if (group.Creator != null)
                            {
                                @group.Creator.Email
                            }
                            else
                            {
                                <span class="sponsor-empty">—</span>
                            }
                        </td>
                        <td>@group.CreationDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <span class="status-badge status-active">Active</span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="empty-state">
                        No user groups found matching your criteria.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- PAGINATION — centered, just below the rows -->
    <div class="table-pagination">
        <div class="pagination-info">
            Showing
            <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
            –
            <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</strong>
            of
            <strong>@Model.TotalCount</strong> user groups.
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="pagination-nav">
                <a class="page-link @(Model.PageNumber == 1 ? "disabled" : "")"
                   asp-page="./Index"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-StatusFilter="@Model.StatusFilter">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a class="page-link @(i == Model.PageNumber ? "active" : "")"
                       asp-page="./Index"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-StatusFilter="@Model.StatusFilter">
                        @i
                    </a>
                }

                <a class="page-link @(Model.PageNumber == Model.TotalPages ? "disabled" : "")"
                   asp-page="./Index"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-StatusFilter="@Model.StatusFilter">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            </nav>
        }
    </div>
</div>