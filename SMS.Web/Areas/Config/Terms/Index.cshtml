@page
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@model SMS.Web.Areas.Config.Pages.Terms.IndexModel
@{
    ViewData["Title"] = "Terms";
    ViewData["PageTitle"] = "Terms";
    ViewData["PageSubTitle"] = "Manage academic terms";
}

@section actionbar {
    @if (CurrentUser.HasRight(AccessRights.CreateTerms))
    {
        <a asp-page="./Upsert" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create
        </a>
    }
}

<div class="table-card">

    <div class="table-count">
        <i class="fa-solid fa-list-ul me-2"></i>
        Total: <strong>@Model.Pagination.TotalCount</strong>
        @(Model.Pagination.TotalCount == 1 ? "term" : "terms")
    </div>

    <form method="get" class="table-toolbar" id="filterForm">
        <div class="filter-wrapper">
            <input type="number" asp-for="YearFilter"
                   class="filter-dropdown"
                   placeholder="Filter by year..."
                   style="width:180px;"
                   id="yearFilter" />
        </div>
        <input type="hidden" asp-for="PageSize" />
        <input type="hidden" asp-for="PageNumber" value="1" id="pageNumberHidden" />
    </form>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>TRM ID</th>
                <th>Academic Year</th>
                <th>Term</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Created By</th>
                <th>Date Created</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Terms.Any())
            {
                @foreach (var t in Model.Terms)
                {
                    <tr>
                        <td>
                            <a asp-area="Config"
                               asp-page="/Terms/Details"
                               asp-route-id="@t.Id"
                               class="reg-link">
                                @t.TermDisplayId
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            </a>
                        </td>
                        <td>@t.AcademicYear</td>
                        <td>Term @t.TermNumber</td>
                        <td>@t.StartDate.ToString("MMM dd, yyyy")</td>
                        <td>@t.EndDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (Model.CreatorEmails.TryGetValue(t.CreatorId, out var email))
                            {
                                @email
                            }
                            else
                            {
                                <span class="sponsor-empty">System Generated</span>
                            }
                        </td>
                        <td>@t.CreationDate.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="empty-state">No terms found matching your criteria.</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" />
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('filterForm');
            const yearFilter = document.getElementById('yearFilter');
            const pageNumberHidden = document.getElementById('pageNumberHidden');
            if (!form || !yearFilter) return;

            let debounceTimer = null;
            const DEBOUNCE_MS = 500;

            yearFilter.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    if (pageNumberHidden) pageNumberHidden.value = '1';
                    form.submit();
                }, DEBOUNCE_MS);
            });
        })();
    </script>
}