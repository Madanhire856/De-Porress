@page
@model SMS.Web.Areas.Faith.Pages.Masses.IndexModel
@{ ViewData["Title"] = "Mass timetable"; ViewData["PageTitle"] = "Mass timetable"; ViewData["PageSubTitle"] = "School Mass times, venues and ministry rosters"; }
@section actionbar { @if (Model.CanCreate) { <a asp-page="./Upsert" class="btn btn-primary">Add Mass</a> } }
@if (TempData["MassStatus"] is string status) { <div class="alert alert-success" role="status">@status</div> }
<div class="table-card"><partial name="~/Pages/Shared/Tables/_TableCount.cshtml" model='new SMS.Web.Pages.Shared.Tables.TableCount(Model.Pagination.TotalCount, "Mass", "Masses")' />
<form method="get" class="table-toolbar" data-auto-filter><div class="toolbar-filters"><div class="filter-wrapper"><select asp-for="Past" class="filter-dropdown" aria-label="Mass timetable period"><option value="false">Upcoming Masses</option><option value="true">Past Masses</option></select></div></div><input asp-for="PageSize" type="hidden" /></form>
<div class="table-responsive"><table class="data-table table-compact">
    <caption class="visually-hidden">School Mass timetable. All times are Zimbabwe time.</caption>
    <thead><tr><th>Date and time</th><th>Liturgical date</th><th>Venue</th><th>Celebrant</th><th>Actions</th></tr></thead>
    <tbody>@foreach (var mass in Model.Masses) {
        <tr><td>@mass.DateTime.ToString("dd MMM yyyy HH:mm")</td><td>@mass.LiturgicalDate.ToString("dd MMM yyyy")</td><td>@mass.Venue</td><td>@mass.Celebrant</td><td><a asp-page="./Details" asp-route-id="@mass.Id" class="btn btn-sm btn-secondary">View Mass</a></td></tr>
    }
    @if (Model.Masses.Count == 0) { <tr><td colspan="5" class="empty-state">No @(Model.Past ? "past" : "upcoming") Masses scheduled.</td></tr> }
    </tbody>
</table></div><partial name="Pagination/_pagination" model="Model.Pagination" /></div>
@section Scripts { <script src="~/js/assignment-filters.js" asp-append-version="true"></script> }
