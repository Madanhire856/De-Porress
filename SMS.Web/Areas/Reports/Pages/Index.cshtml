@page
@model SMS.Web.Areas.Reports.Pages.IndexModel
@{ ViewData["Title"] = "Reports"; ViewData["PageTitle"] = "Reports"; ViewData["PageSubTitle"] = "School reports with filters, printing and CSV export"; }
@section Styles { <link rel="stylesheet" href="~/css/school-reports.css" asp-append-version="true" /> }
<div class="table-card"><partial name="~/Pages/Shared/Tables/_TableCount.cshtml" model='new SMS.Web.Pages.Shared.Tables.TableCount(Model.Reports.Count, "report")' />
<form method="get" class="table-toolbar" data-auto-filter><div class="toolbar-filters"><div class="filter-wrapper"><select asp-for="Group" class="filter-dropdown" aria-label="Report category"><option value="">All categories</option>@foreach (var group in Model.Groups) { <option value="@group">@group</option> }</select></div></div><div class="search-wrapper"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input asp-for="SearchTerm" class="search-input" placeholder="Search reports…" aria-label="Search reports" autocomplete="off" /></div></form>
<div class="table-responsive"><table class="data-table table-compact"><thead><tr><th>Report</th><th>Category</th><th>Description</th></tr></thead><tbody>
@foreach (var report in Model.Reports.OrderBy(x => x.Group).ThenBy(x => x.Title)) {
    <tr><td><a class="reg-link" asp-page="./Run" asp-route-key="@report.Key">@report.Title <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></td><td>@report.Group</td><td class="table-copy">@report.Description</td></tr>
}
@if (Model.Reports.Count == 0) { <tr><td colspan="3" class="empty-state">@(string.IsNullOrWhiteSpace(Model.SearchTerm) && string.IsNullOrEmpty(Model.Group) ? "No reports are assigned to your account. Ask your administrator to review your access group." : "No reports match these filters.")</td></tr> }
</tbody></table></div></div>
@section Scripts { <script src="~/js/assignment-filters.js" asp-append-version="true"></script> }
