@page
@model SMS.Web.Areas.Academics.Pages.SubjectAssignments.IndexModel
@{
    ViewData["PageTitle"] = "Subject Assignments";
    ViewData["PageSubTitle"] = "View teaching subjects and manage assignments";
}
@if (TempData["SubjectsSaved"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
<div class="table-card">
    <div class="table-count"><i class="fas fa-chalkboard-teacher me-2" aria-hidden="true"></i> @Model.Teachers.Count teaching staff</div>
    <form method="get" class="table-toolbar" data-auto-filter>
        <div class="search-wrapper"><i class="fas fa-search" aria-hidden="true"></i>
            <input asp-for="SearchTerm" class="search-input" aria-label="Search teacher or subject" placeholder="Search teacher or subject" />
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) { <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a> }
    </form>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Teacher</th><th>Status</th><th>Assigned subjects</th>@if (Model.CanManage) { <th>Action</th> }</tr></thead>
            <tbody>
            @foreach (var teacher in Model.Teachers)
            {
                <tr><td>@teacher.Name @teacher.Surname</td><td>@(teacher.IsActive == true ? "Active" : "Inactive")</td>
                    <td>@(teacher.TeacherSubjects.Count == 0 ? "No subjects assigned" : string.Join(", ", teacher.TeacherSubjects.Select(x => x.Subject.Name).Distinct().OrderBy(x => x)))</td>
                    @if (Model.CanManage)
                    {
                        <td>@if (teacher.IsActive == true) {
                            <a asp-page="/Staff/AssignSubject" asp-route-staffId="@teacher.Id" class="btn btn-sm btn-outline-primary">Manage subjects</a>
                        }</td>
                    }
                </tr>
            }
            @if (Model.Teachers.Count == 0) { <tr><td colspan="4">No teaching staff found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script src="~/js/assignment-filters.js" asp-append-version="true"></script>
}
