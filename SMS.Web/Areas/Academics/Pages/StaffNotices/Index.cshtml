@page
@model SMS.Web.Areas.Academics.Pages.StaffNotices.IndexModel
@using SMS.Web.Services
@{ ViewData["PageTitle"] = "Staff Notices"; ViewData["PageSubTitle"] = "School communications for signed-in staff"; }
@section actionbar {
    @if (Model.CanManage) {
        @if (Model.CanCreate) { <a asp-page="/Notices/Upsert" class="btn btn-primary">Create notice</a> }
        <a asp-page="/Notices/Index" class="btn btn-secondary">Manage notices</a>
    }
}
<div class="table-card">
<partial name="~/Pages/Shared/Tables/_TableCount.cshtml" model='new SMS.Web.Pages.Shared.Tables.TableCount(Model.Total, "notice")' />
<form method="get" class="table-toolbar" data-auto-filter><div class="search-wrapper"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input asp-for="SearchTerm" class="search-input" aria-label="Search staff notices" placeholder="Search staff notices…" autocomplete="off" /></div></form>
<div class="table-responsive"><table class="data-table table-compact"><thead><tr><th>Notice</th><th>Published</th><th>Preview</th><th>Audience</th></tr></thead><tbody>
@foreach (var notice in Model.Notices) {
    <tr><td><a asp-page="./Details" asp-route-id="@notice.Id" class="reg-link">@notice.Title <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></td><td>@notice.CreationDate.AddHours(2).ToString("dd MMM yyyy")</td><td class="table-copy">@SchoolNotices.Preview(notice.Body)</td><td><span class="status-badge status-active">Staff only</span></td></tr>
}
@if (Model.Notices.Count == 0) { <tr><td colspan="4" class="empty-state">No published staff notices found.</td></tr> }
</tbody></table></div>
<partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" />
</div>
@section Scripts { <script src="~/js/assignment-filters.js" asp-append-version="true"></script> }
