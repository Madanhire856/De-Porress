@page
@model SMS.Web.Areas.Academics.Pages.Prefects.NominationsModel
@using SMS.Lib
@{ ViewData["PageTitle"] = "Prefect Nominations"; ViewData["PageSubTitle"] = "Track student nominations and appointment decisions"; }
@inject SMS.Web.Services.WorkspaceAccess Workspace
@section actionbar { @if (SMS.Web.Services.PrefectAccess.CanNominate(Workspace)) { <a asp-page="./Nominate" class="btn btn-primary">Nominate student</a> } }
@if (TempData["Success"] is string message) { <div class="alert alert-success" role="status">@message</div> }
<div class="table-card"><partial name="~/Pages/Shared/Tables/_TableCount.cshtml" model='new SMS.Web.Pages.Shared.Tables.TableCount(Model.Total, "nomination")' /><form method="get" class="table-toolbar" data-auto-filter>
    <div class="toolbar-filters"><div class="filter-wrapper"><select asp-for="Status" class="filter-dropdown" aria-label="Nomination status"><option value="">All statuses</option><option value="0">Pending</option><option value="2">Under review</option><option value="1">Appointed</option><option value="5">Rejected</option></select></div></div>
    <div class="search-wrapper"><i class="fas fa-search" aria-hidden="true"></i><input asp-for="SearchTerm" class="search-input" placeholder="Search nominated students…" aria-label="Search nominated students" /></div>
</form>
<div class="table-responsive"><table class="data-table table-compact"><thead><tr><th>Student</th><th>Class</th><th>Proposed post</th><th>Status</th><th>Nominated by</th><th>Date</th><th>Reason and review</th><th>Actions</th></tr></thead><tbody>
@foreach (var nomination in Model.Nominations) {
    <tr><td>@nomination.Student.Name @nomination.Student.Surname</td><td>@(nomination.Student.Class?.Name ?? "No class")</td>
    <td>@(nomination.PostTitleId.HasValue && Enum.IsDefined(typeof(PrefectPostTitle), nomination.PostTitleId.Value) ? ((PrefectPostTitle)nomination.PostTitleId.Value).ToDisplayName() : "Post to be decided")</td>
    <td><span class="status-badge">@SMS.Web.Areas.Academics.Pages.Prefects.NominationsModel.StatusName(nomination.StatusId)</span></td><td>@(nomination.NominatedByUser.Name ?? "Staff")</td><td>@nomination.CreationDate.AddHours(2).ToString("dd MMM yyyy")</td>
    <td class="table-copy"><p class="staff-notice-body">@nomination.Reason</p>@if (!string.IsNullOrWhiteSpace(nomination.ReviewNotes)) { <p class="staff-notice-body"><strong>Review:</strong> @nomination.ReviewNotes</p> }</td>
    <td class="table-copy">@if (nomination.PrefectId.HasValue) { <a asp-page="./Details" asp-route-id="@nomination.PrefectId" class="reg-link">Appointment</a> }
        @if (nomination.StatusId is 0 or 2) {
            @if (Model.CanAppoint) { <a asp-page="./Upsert" asp-route-nominationId="@nomination.Id" class="btn btn-sm btn-primary">Review and appoint</a> }
            @if (Model.CanReview) {
                <form method="post" asp-page-handler="Review" asp-route-id="@nomination.Id" class="table-review-form">
                    <label for="notes-@nomination.Id" class="form-label">Review notes (required for rejection)</label><textarea id="notes-@nomination.Id" name="notes" class="form-control mb-2" rows="2" maxlength="1000"></textarea>
                    <button type="submit" name="decision" value="vetting" class="btn btn-secondary">Mark under review</button>
                    <button type="submit" name="decision" value="reject" class="btn btn-outline-secondary">Reject nomination</button>
                </form>
            }
        }
</td></tr>
}
@if (Model.Nominations.Count == 0) { <tr><td colspan="8" class="empty-state">No nominations found.</td></tr> }
</tbody></table></div><partial name="~/Pages/Shared/Pagination/_pagination.cshtml" model="Model.Pagination" /></div>
@section Scripts { <script src="~/js/assignment-filters.js" asp-append-version="true"></script> }
