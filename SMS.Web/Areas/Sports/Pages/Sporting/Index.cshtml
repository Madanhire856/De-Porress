@page
@using SMS.Lib
@model SMS.Web.Areas.Sports.Pages.Sporting.IndexModel
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Sports";
    ViewData["PageTitle"] = "Sports & Coaches";
    ViewData["PageSubTitle"] = "Manage sports, coaches, and competitions";

    var canEditSports = CurrentUser.HasRight(AccessRights.EditSports);
    var canAssignCoaches = CurrentUser.HasRight(AccessRights.AssignSportsCoaches);
    var showActions = canEditSports || canAssignCoaches;
}

@if (!Model.Sports.Any())
{
    <div class="table-card"><div class="table-count"><i class="fa-solid fa-list-ul me-2" aria-hidden="true"></i> Total: <strong>0</strong> sports</div><table class="data-table table-compact"><thead><tr><th>Sport</th><th>Head coach</th><th>Assignments</th></tr></thead><tbody><tr><td colspan="3" class="empty-state">No sports defined yet. <a asp-area="Config" asp-page="/Sports/Index" class="btn btn-primary">Configure sports</a></td></tr></tbody></table></div>
}
else
{
    <!-- ===== HEADER STATS ===== -->
    <div class="house-stats">
        <div class="house-stat">
            <i class="fa-solid fa-futbol"></i>
            <div>
                <div class="house-stat-value">@Model.TotalSports</div>
                <div class="house-stat-label">
                    @(Model.TotalSports == 1 ? "Sport" : "Sports")
                </div>
            </div>
        </div>
        <div class="house-stat">
            <i class="fa-solid fa-user-check"></i>
            <div>
                <div class="house-stat-value">@Model.TotalCoaches</div>
                <div class="house-stat-label">Assigned Coaches</div>
            </div>
        </div>
        <div class="house-stat">
            <i class="fa-solid fa-trophy"></i>
            <div>
                <div class="house-stat-value">@Model.TotalCompetitions</div>
                <div class="house-stat-label">
                    @(Model.TotalCompetitions == 1 ? "Competition" : "Competitions")
                </div>
            </div>
        </div>
    </div>

    <div class="table-card"><partial name="~/Pages/Shared/Tables/_TableCount.cshtml" model='new SMS.Web.Pages.Shared.Tables.TableCount(Model.Sports.Count, "sport", "sports")' />
    <div class="table-toolbar"><div class="toolbar-filters"><label class="assignment-toggle"><input type="checkbox" id="onlyIncomplete" /><span>Only sports missing a head coach</span></label></div><div class="search-wrapper"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input class="search-input" type="search" id="sportSearch" placeholder="Search sports or coaches…" aria-label="Search sports" autocomplete="off" /></div></div>
    <div class="table-responsive"><table class="data-table table-compact"><thead><tr><th>Sport</th><th>Head coach</th><th>Other assignments</th><th>Assigned</th><th>Competitions</th><th>Status</th><th>Actions</th></tr></thead><tbody id="sportGrid">
    @foreach (var s in Model.Sports) {
        var blob = (s.Name + " " + string.Join(" ", s.Coaches.Select(person => person.FullName))).ToLower();
        <tr data-search="@blob" data-has-master="@(s.HeadCoach != null ? "1" : "0")"><td>@s.Name</td><td class="table-copy">@(s.HeadCoach?.FullName ?? "Unassigned") @if (s.HeadCoach != null) { <small class="d-block">@s.HeadCoach.CategoryName</small> }</td>
        <td class="table-copy">@foreach (var person in s.Assistants) { <div>@person.FullName <small>· @person.RoleName · @person.CategoryName</small></div> } @if (!s.Coaches.Any()) { <span>No coaches assigned yet</span> }</td>
        <td>@s.CoachCount</td><td>@s.CompetitionCount</td><td><span class="status-badge">@(s.HeadCoach == null ? "No head coach" : "Assigned")</span></td><td><div class="table-actions">@if (canEditSports) { <a asp-area="Sports" asp-page="/Sporting/AddCompetition" asp-route-sportId="@s.Id" class="btn btn-sm btn-primary">Competition</a> }
        @if (canAssignCoaches) { <a asp-area="Sports" asp-page="/Sporting/Assign" asp-route-sportId="@s.Id" class="btn btn-sm btn-secondary">Coaches</a> }</div></td></tr>
    }
    <tr id="sportNoResults" style="display:none"><td colspan="7" class="empty-state">No sports match your search.</td></tr>
    </tbody></table></div></div>
}
@section Scripts {
    <script>
        (function () {
            const search = document.getElementById('sportSearch');
            const toggle = document.getElementById('onlyIncomplete');
            const grid = document.getElementById('sportGrid');
            const noResults = document.getElementById('sportNoResults');

            if (!grid || !search || !toggle) return;

            const cards = Array.from(grid.querySelectorAll('tr[data-search]'));

            function apply() {
                const q = (search.value || '').trim().toLowerCase();
                const onlyIncomplete = toggle.checked;
                let visible = 0;

                cards.forEach(card => {
                    const matchesSearch = !q || (card.dataset.search || '').includes(q);
                    const matchesMaster = !onlyIncomplete || card.dataset.hasMaster === '0';
                    const show = matchesSearch && matchesMaster;

                    card.style.display = show ? '' : 'none';
                    if (show) visible++;
                });

                const total = grid.closest('.table-card').querySelector('.table-count strong');
                if (total) {
                    total.textContent = visible;
                    total.nextSibling.textContent = visible === 1 ? ' sport' : ' sports';
                }
                if (noResults) {
                    noResults.style.display = (cards.length > 0 && visible === 0) ? '' : 'none';
                }
            }

            search.addEventListener('input', apply);
            toggle.addEventListener('change', apply);
        })();
    </script>
}
