@page "{sportId:guid}"
@model SMS.Web.Areas.Sports.Pages.Sporting.AssignModel
@using SMS.Lib
@{
    ViewData["Title"] = "Assign Coaches";
    ViewData["PageTitle"] = "Assign Coaches";
    ViewData["PageSubTitle"] = $"Sport: {Model.Sport.Name}";
}

<form method="post" id="assignForm">
    <div class="form-card">

        <div class="card-body">

            <div id="hiddenPayload"></div>

            <div class="assignment-toolbar">
                <div class="assignment-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text"
                           id="teacherSearch"
                           placeholder="Search teachers by name or category..."
                           autocomplete="off" />
                </div>

                <label class="assignment-toggle">
                    <input type="checkbox" id="onlyAssigned" />
                    <span>Show only assigned</span>
                </label>
            </div>

            <div class="role-summary" id="roleSummary">
                @foreach (var role in EnumExtensions.AllTeacherSportRoles())
                {
                    var rid = (int)role;
                    var count = Model.RoleCounts.TryGetValue(rid, out var c) ? c : 0;

                    <span class="role-chip @(count > 0 ? "role-chip-active" : "")" data-role-id="@rid">
                        <i class="fa-solid @(rid == 0 ? "fa-whistle" : "fa-user")"></i>
                        @role.ToDisplayName()
                        <span class="role-chip-count">@count</span>
                    </span>
                }
            </div>

            <!-- ===== TEACHERS ===== -->
            <div class="form-section-title" style="margin-top: 1rem;">
                <i class="fa-solid fa-chalkboard-user"></i> Teachers
                <span class="rights-counter" id="selectedCount">0 selected</span>
            </div>

            @if (Model.Teachers.Any())
            {
                <div class="assignment-table" id="teachersList">
                    @foreach (var t in Model.Teachers)
                    {
                        <div class="assignment-row @(t.IsAssigned ? "is-assigned" : "")"
                             data-staff-id="@t.StaffId"
                             data-name="@t.FullName.ToLower()"
                             data-category="@t.CategoryName.ToLower()">

                            <label class="assignment-check">
                                <input type="checkbox"
                                       class="teacher-checkbox"
                                       value="@t.StaffId"
                                       @(t.IsAssigned ? "checked" : "") />
                            </label>

                            <div class="assignment-info">
                                <div class="assignment-name">@t.FullName</div>
                                <div class="assignment-meta">
                                    <span class="assignment-category">@t.CategoryName</span>
                                </div>
                            </div>

                            <div class="assignment-role">
                                <select class="role-select @(t.IsAssigned ? "" : "role-select-inactive")">
                                    <option value="" disabled selected="@(t.RoleId == null)">
                                        — Select role —
                                    </option>
                                    @foreach (var role in EnumExtensions.AllTeacherSportRoles())
                                    {
                                        var rid = (int)role;
                                        <option value="@rid" selected="@(t.RoleId == rid)">
                                            @role.ToDisplayName()
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>

                <!-- No search results -->
                <div class="empty-state" id="noResults" style="display: none;">
                    <i class="fa-solid fa-magnifying-glass me-2"></i>
                    No teachers match your search.
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fa-solid fa-users-slash me-2"></i>
                    No eligible teachers found. Add active staff first.
                </div>
            }
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i> Save Assignments
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('assignForm');
            const payload = document.getElementById('hiddenPayload');
            const countEl = document.getElementById('selectedCount');
            const roleSummary = document.getElementById('roleSummary');
            const searchInput = document.getElementById('teacherSearch');
            const onlyAssignedToggle = document.getElementById('onlyAssigned');
            const noResults = document.getElementById('noResults');

            const rows = Array.from(document.querySelectorAll('.assignment-row'));
            const roleChips = Array.from(roleSummary.querySelectorAll('.role-chip'));

            // ============================================================
            //  Update visual state of a single row
            // ============================================================
            function refreshRow(row) {
                const cb = row.querySelector('.teacher-checkbox');
                const select = row.querySelector('.role-select');

                const hasRole = select.value !== '';

                row.classList.toggle('is-checked', cb.checked);
                select.classList.toggle('role-select-inactive', !cb.checked || !hasRole);
                select.disabled = !cb.checked;

                // Flag rows that need attention
                row.classList.toggle('is-missing-role', cb.checked && !hasRole);
            }

            // ============================================================
            //  Update header counters (total selected + per-role chips)
            // ============================================================
            function refreshCounters() {
                let selected = 0;
                const roleCounts = {};

                rows.forEach(row => {
                    const cb = row.querySelector('.teacher-checkbox');
                    const select = row.querySelector('.role-select');
                    if (!cb.checked) return;

                    selected++;
                    if (select.value === '') return;   // no role yet

                    const rid = parseInt(select.value, 10);
                    roleCounts[rid] = (roleCounts[rid] || 0) + 1;
                });

                countEl.textContent = selected + ' selected';

                roleChips.forEach(chip => {
                    const rid = parseInt(chip.dataset.roleId, 10);
                    const count = roleCounts[rid] || 0;
                    const countSpan = chip.querySelector('.role-chip-count');

                    countSpan.textContent = count;
                    chip.classList.toggle('role-chip-active', count > 0);
                });
            }

            // ============================================================
            //  Apply the search + filter to the row list
            // ============================================================
            function applyFilters() {
                const query = searchInput.value.trim().toLowerCase();
                const onlyAssigned = onlyAssignedToggle.checked;

                let visibleCount = 0;

                rows.forEach(row => {
                    const name = row.dataset.name || '';
                    const category = row.dataset.category || '';
                    const cb = row.querySelector('.teacher-checkbox');

                    const matchesSearch = !query
                        || name.includes(query)
                        || category.includes(query);

                    const matchesAssigned = !onlyAssigned || cb.checked;

                    const visible = matchesSearch && matchesAssigned;
                    row.style.display = visible ? '' : 'none';

                    if (visible) visibleCount++;
                });

                if (noResults) {
                    noResults.style.display =
                        (rows.length > 0 && visibleCount === 0) ? '' : 'none';
                }
            }

            // ============================================================
            //  Wire events
            // ============================================================
            rows.forEach(row => {
                const cb = row.querySelector('.teacher-checkbox');
                const select = row.querySelector('.role-select');

                cb.addEventListener('change', () => {
                    refreshRow(row);
                    refreshCounters();
                    applyFilters();
                });

                select.addEventListener('change', () => {
                    refreshRow(row);
                    refreshCounters();
                });
            });

            searchInput.addEventListener('input', applyFilters);
            onlyAssignedToggle.addEventListener('change', applyFilters);

            // ============================================================
            //  Build the hidden payload on submit — block on missing roles
            // ============================================================
            form.addEventListener('submit', function (e) {
                // 1. Find checked rows without a role
                const missing = rows.filter(row => {
                    const cb = row.querySelector('.teacher-checkbox');
                    const select = row.querySelector('.role-select');
                    return cb.checked && select.value === '';
                });

                if (missing.length > 0) {
                    e.preventDefault();

                    // Clear previous highlights, then flag the offenders
                    rows.forEach(r => r.classList.remove('is-missing-role'));
                    missing.forEach(r => r.classList.add('is-missing-role'));

                    // Scroll to the first offender
                    missing[0].scrollIntoView({ behavior: 'smooth', block: 'center' });

                    alert('Please select a role for every checked teacher before saving.');
                    return;
                }

                // 2. Build payload
                payload.innerHTML = '';

                rows.forEach(row => {
                    const cb = row.querySelector('.teacher-checkbox');
                    if (!cb.checked) return;

                    const staffId = row.dataset.staffId;
                    const roleId = row.querySelector('.role-select').value;
                    if (roleId === '') return;

                    const sid = document.createElement('input');
                    sid.type = 'hidden';
                    sid.name = 'SelectedStaffIds';
                    sid.value = staffId;
                    payload.appendChild(sid);

                    const rid = document.createElement('input');
                    rid.type = 'hidden';
                    rid.name = 'SelectedRoleIds';
                    rid.value = roleId;
                    payload.appendChild(rid);
                });
            });

            // ============================================================
            //  Initial state
            // ============================================================
            rows.forEach(refreshRow);
            refreshCounters();
        })();
    </script>
}