@page
@using SMS.Lib
@model SMS.Web.Areas.Sports.Pages.Houses.IndexModel
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Houses";
    ViewData["PageTitle"] = "House Assignments";
    ViewData["PageSubTitle"] = "Manage house teacher assignments and roles";
    var canEdit = CurrentUser.HasRight(AccessRights.EditHouses);
}

@if (!Model.Houses.Any())
{
    <div class="table-card"><div class="table-count"><i class="fa-solid fa-list-ul me-2" aria-hidden="true"></i> Total: <strong>0</strong> houses</div><table class="data-table table-compact"><thead><tr><th>House</th><th>House master</th><th>Assignments</th></tr></thead><tbody><tr><td colspan="3" class="empty-state">No houses defined yet. <a asp-area="Config" asp-page="/Houses/Index" class="btn btn-primary">Configure houses</a></td></tr></tbody></table></div>
}
else
{
    <!-- ===== HEADER STATS ===== -->
    <div class="house-stats">
        <div class="house-stat">
            <i class="fa-solid fa-house-chimney"></i>
            <div>
                <div class="house-stat-value">@Model.TotalHouses</div>
                <div class="house-stat-label">
                    @(Model.TotalHouses == 1 ? "House" : "Houses")
                </div>
            </div>
        </div>
        <div class="house-stat">
            <i class="fa-solid fa-user-check"></i>
            <div>
                <div class="house-stat-value">@Model.TotalAssigned</div>
                <div class="house-stat-label">Assigned Teachers</div>
            </div>
        </div>
        <div class="house-stat @(Model.HousesWithoutMaster > 0 )">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div>
                <div class="house-stat-value">@Model.HousesWithoutMaster</div>
                <div class="house-stat-label">Without a Master</div>
            </div>
        </div>
    </div>

    <div class="table-card"><partial name="~/Pages/Shared/Tables/_TableCount.cshtml" model='new SMS.Web.Pages.Shared.Tables.TableCount(Model.Houses.Count, "house", "houses")' />
    <div class="table-toolbar"><div class="toolbar-filters"><label class="assignment-toggle"><input type="checkbox" id="onlyIncomplete" /><span>Only houses missing a house master</span></label></div><div class="search-wrapper"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input class="search-input" type="search" id="houseSearch" placeholder="Search houses or teachers…" aria-label="Search houses" autocomplete="off" /></div></div>
    <div class="table-responsive"><table class="data-table table-compact"><thead><tr><th>House</th><th>House master</th><th>Other assignments</th><th>Assigned</th><th>Status</th><th>Actions</th></tr></thead><tbody id="houseGrid">
    @foreach (var h in Model.Houses) {
        var blob = (h.Name + " " + string.Join(" ", h.Teachers.Select(person => person.FullName))).ToLower();
        <tr data-search="@blob" data-has-master="@(h.Master != null ? "1" : "0")"><td><span class="house-dot" style="@(!string.IsNullOrEmpty(h.Color) ? $"background:{h.Color};" : "")"></span> @h.Name</td><td class="table-copy">@(h.Master?.FullName ?? "Unassigned") @if (h.Master != null) { <small class="d-block">@h.Master.CategoryName</small> }</td>
        <td class="table-copy">@foreach (var person in h.Assistants) { <div>@person.FullName <small>· @person.RoleName · @person.CategoryName</small></div> } @if (!h.Teachers.Any()) { <span>No teachers assigned yet</span> }</td>
        <td>@h.TeacherCount</td><td><span class="status-badge">@(h.Master == null ? "No house master" : "Assigned")</span></td><td><div class="table-actions">@if (canEdit) { <a asp-area="Sports" asp-page="/Houses/Assign" asp-route-houseId="@h.Id" class="btn btn-sm btn-secondary">Manage</a> }</div></td></tr>
    }
    <tr id="houseNoResults" style="display:none"><td colspan="6" class="empty-state">No houses match your search.</td></tr>
    </tbody></table></div></div>
}
@section Scripts {
    <script>
        (function () {
            const search = document.getElementById('houseSearch');
            const toggle = document.getElementById('onlyIncomplete');
            const grid = document.getElementById('houseGrid');
            const noResults = document.getElementById('houseNoResults');

            if (!grid || !search || !toggle) return;

            const cards = Array.from(grid.querySelectorAll('tr[data-search]'));

            function apply() {
                const q = (search.value || '').trim().toLowerCase();
                const onlyIncomplete = toggle.checked;
                let visible = 0;

                cards.forEach(card => {
                    const matchesSearch = !q || (card.dataset.search || '').includes(q);
                    const matchesMaster = !onlyIncomplete || card.dataset.hasMaster === '0';
                    const show = matchesSearch && matchesMaster;

                    card.style.display = show ? '' : 'none';
                    if (show) visible++;
                });

                const total = grid.closest('.table-card').querySelector('.table-count strong');
                if (total) {
                    total.textContent = visible;
                    total.nextSibling.textContent = visible === 1 ? ' house' : ' houses';
                }
                if (noResults) {
                    noResults.style.display = (cards.length > 0 && visible === 0) ? '' : 'none';
                }
            }

            search.addEventListener('input', apply);
            toggle.addEventListener('change', apply);
        })();
    </script>
}
