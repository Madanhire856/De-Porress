@page
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@model SMS.Web.Areas.Finance.Pages.Fees.BankModel
@{
    ViewData["Title"] = "Bank Statement";
    ViewData["PageTitle"] = "Bank Statement";
    ViewData["PageSubTitle"] = "Bank statement lines awaiting reconciliation";
}

@section actionbar {
    <a asp-page="./Reconcile" class="btn btn-primary">
        <i class="fa-solid fa-link"></i> Reconcile
    </a>
}

@if (TempData["BankSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show flash flash-success" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>
        @TempData["BankSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["BankError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show flash flash-error" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        @TempData["BankError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ===== ADD ENTRY ===== -->
<form method="post" class="form-compact" style="margin-bottom: 1rem;">
    <div class="form-card">
        <div class="card-body">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-section-title">
                <i class="fa-solid fa-plus"></i> Record Bank Statement Line
            </div>

            <div class="form-grid-2" style="margin-bottom: 1.5rem;">

                <div class="form-group">
                    <label class="form-label" asp-for="Input.EntryDate">
                        Date <span class="required">*</span>
                    </label>
                    <input asp-for="Input.EntryDate"
                           type="text"
                           class="form-control datepicker"
                           placeholder="yyyy-mm-dd"
                           autocomplete="off"
                           required />
                    <span asp-validation-for="Input.EntryDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.Amount">
                        Amount <span class="required">*</span>
                    </label>
                    <input asp-for="Input.Amount"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control"
                           placeholder="0.00"
                           required />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.BankReference">Bank Reference</label>
                    <input asp-for="Input.BankReference"
                           class="form-control"
                           placeholder="From the bank statement" />
                    <span asp-validation-for="Input.BankReference" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.CurrencyId">Currency</label>
                    <input asp-for="Input.CurrencyId"
                           class="form-control"
                           placeholder="USD, ZAR, ..." />
                    <span asp-validation-for="Input.CurrencyId" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label class="form-label" asp-for="Input.Description">Description</label>
                    <input asp-for="Input.Description" class="form-control" />
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>

            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i> Add Statement Line
            </button>
        </div>
    </div>
</form>

<!-- ===== LIST ===== -->
<div class="table-card">
    <div class="table-count">
        <i class="fa-solid fa-list-ul me-2"></i>
        Total: <strong>@Model.Entries.Count</strong> entries
        (@Model.Entries.Count(e => !e.IsMatched) unmatched)
    </div>

    <table class="data-table table-compact">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Reference</th>
                <th style="text-align:right;">Amount</th>
                <th>Status</th>
                <th style="width: 100px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Entries.Any())
            {
                @foreach (var e in Model.Entries)
                {
                    <tr>
                        <td>@e.Date.ToString("dd MMM yyyy")</td>
                        <td>@(string.IsNullOrWhiteSpace(e.Description) ? "—" : e.Description)</td>
                        <td><span class="info-value-mono">@(e.Reference ?? "—")</span></td>
                        <td style="text-align:right;">
                            <strong>@e.Amount.ToString("N2")</strong>
                            <span class="info-value-mono">@e.Currency</span>
                        </td>
                        <td>
                            @if (e.IsMatched)
                            {
                                <span class="status-badge status-active">Matched</span>
                                <div class="info-value-mono" style="font-size: 0.7rem; margin-top: 2px;">
                                    @e.MatchedReceipt · @e.MatchedStudent
                                </div>
                            }
                            else
                            {
                                <span class="status-badge status-count">Unmatched</span>
                            }
                        </td>
                        <td>
                            @if (!e.IsMatched)
                            {
                                <form method="post"
                                      asp-page-handler="Delete"
                                      asp-route-id="@e.Id"
                                      onsubmit="return confirm('Delete this unmatched entry?');"
                                      style="display: inline;">
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="empty-state">
                        No bank statement entries yet. Add one above to start reconciling.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            $('.datepicker').datepicker({
                dateFormat: 'yy-mm-dd',
                changeMonth: true,
                changeYear: true,
                showAnim: 'fadeIn',
                maxDate: 0  
            });
            $('.datepicker').on('keydown', function (e) {
                e.preventDefault();
            });

            // ---- Auto-fade the success flash ----
            setTimeout(function () {
                $('.flash-success').fadeOut(500, function () { $(this).remove(); });
            }, 4000);
        });
    </script>
}