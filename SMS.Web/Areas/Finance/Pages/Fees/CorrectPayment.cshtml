@page "{id:guid}"
@model SMS.Web.Areas.Finance.Pages.Fees.CorrectPaymentModel
@{
    ViewData["Title"] = "Correct Payment";
    ViewData["PageTitle"] = "Correct Payment";
    ViewData["PageSubTitle"] = Model.StudentName;
}

@section actionbar {
    <a asp-page="./Ledger" asp-route-id="@Model.LedgerId" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back to Ledger</a>
}

<form method="post" class="form-compact">
    <div class="form-card">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <input asp-for="Input.PaymentId" type="hidden" />
            <div class="form-section-title"><i class="fa-solid fa-pen-to-square"></i> Correct @Model.ReceiptDisplay</div>
            <div class="reversal-warning">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span>The original and corrected values, the correction reason, your name, and time are kept in the audit log.</span>
            </div>
            <div class="form-grid-2" style="margin-top: 1rem;">
                <div class="form-group"><label class="form-label" asp-for="Input.PaymentDate">Payment Date</label><input asp-for="Input.PaymentDate" type="date" class="form-control" /><span asp-validation-for="Input.PaymentDate" class="text-danger"></span></div>
                <div class="form-group"><label class="form-label" asp-for="Input.Amount">Amount</label><input asp-for="Input.Amount" type="number" min="0.01" step="0.01" class="form-control" /><span asp-validation-for="Input.Amount" class="text-danger"></span></div>
                <div class="form-group"><label class="form-label" asp-for="Input.PaymentMethodId">Payment Method</label><select asp-for="Input.PaymentMethodId" class="form-control"><option value="">— Select method —</option>@foreach (var method in Model.MethodOptions) { <option value="@method.Id">@method.Label</option> }</select><span asp-validation-for="Input.PaymentMethodId" class="text-danger"></span></div>
                <div class="form-group"><label class="form-label" asp-for="Input.ReferenceNumber">Reference</label><input asp-for="Input.ReferenceNumber" class="form-control" /><span asp-validation-for="Input.ReferenceNumber" class="text-danger"></span></div>
                <div class="form-group full-width"><label class="form-label" asp-for="Input.ProofOfPaymentUrl">Proof of Payment URL</label><input asp-for="Input.ProofOfPaymentUrl" class="form-control" /></div>
                <div class="form-group full-width"><label class="form-label" asp-for="Input.CorrectionReason">Reason for correction <span class="required">*</span></label><textarea asp-for="Input.CorrectionReason" rows="4" class="form-control" placeholder="Explain what was incorrect and why it was corrected"></textarea><span asp-validation-for="Input.CorrectionReason" class="text-danger"></span></div>
            </div>
        </div>
        <div class="card-footer"><a asp-page="./Ledger" asp-route-id="@Model.LedgerId" class="btn btn-secondary">Cancel</a><button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Correction</button></div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
