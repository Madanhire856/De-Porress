@page "{id:guid?}"
@model SMS.Web.Areas.Finance.Pages.Fees.UpsertModel
@using SMS.Lib
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = Model.IsEditing ? "Edit Fee" : "New Fee";
    ViewData["PageTitle"] = Model.IsEditing ? "Edit Fee" : "New Fee";
    ViewData["PageSubTitle"] = Model.IsEditing
        ? "Update an existing fee"
        : "Add a fee to the structure";
}

<form method="post" class="form-compact">
    <div class="form-card">
        <div class="card-body">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input type="hidden" asp-for="Input.Id" />

            <div class="form-section-title">
                <i class="fa-solid fa-file-invoice-dollar"></i> Fee Details
            </div>

            <div class="form-grid-2" style="margin-bottom: 1.5rem;">

                <div class="form-group">
                    <label class="form-label" asp-for="Input.GradeId">
                        Grade <span class="required">*</span>
                    </label>
                    <select asp-for="Input.GradeId" asp-items="Model.Grades"
                            class="form-control" required>
                        <option value="">— Select grade —</option>
                    </select>
                    <span asp-validation-for="Input.GradeId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.TermId">
                        Term <span class="required">*</span>
                    </label>
                    <select asp-for="Input.TermId" asp-items="Model.Terms"
                            class="form-control" required>
                        <option value="">— Select term —</option>
                    </select>
                    <span asp-validation-for="Input.TermId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.LevyTypeId">
                        Levy Type <span class="required">*</span>
                    </label>
                    <select asp-for="Input.LevyTypeId" asp-items="Model.LevyTypes"
                            class="form-control" required>
                        <option value="">— Select levy type —</option>
                    </select>
                    <span asp-validation-for="Input.LevyTypeId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.CurrencyId">
                        Currency <span class="required">*</span>
                    </label>
                    <select asp-for="Input.CurrencyId" asp-items="Model.Currencies"
                            class="form-control" required>
                        <option value="">— Select currency —</option>
                    </select>
                    <span asp-validation-for="Input.CurrencyId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label" asp-for="Input.Amount">
                        Amount <span class="required">*</span>
                    </label>
                    <input asp-for="Input.Amount"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control"
                           placeholder="0.00"
                           required />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>

            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i>
                @(Model.IsEditing ? "Save Changes" : "Add Fee")
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}