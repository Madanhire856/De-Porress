@page "{id:guid?}"
@model SMS.Web.Areas.Finance.Pages.Fees.UpsertModel
@using SMS.Lib
@using SMS.Web.Areas.Finance.Pages.Fees
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Fee Structure";
    ViewData["PageTitle"] = Model.IsEditing ? "Edit Fee" : "New Fee";
    ViewData["PageSubTitle"] = Model.IsEditing
        ? "Update an existing fee"
        : "Add a fee to the structure";
}

@section actionbar {
    <a asp-page="./FeesStructures" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Fee Structure
    </a>
}

<form method="post" class="form-compact" id="feeForm">
    <div class="form-card">
        <div class="card-body">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input type="hidden" asp-for="Input.Id" />

            <div class="form-section-title">
                <i class="fa-solid fa-file-invoice-dollar"></i> Fee Details
            </div>

            <!-- ===== SCOPE ===== -->
            @if (!Model.IsEditing)
            {
                <div class="form-section-title form-section-title-spaced">
                    <i class="fa-solid fa-bullseye"></i> Apply To
                </div>

                <div class="rights-list rights-list-spaced rights-list-inline">
                    <label class="right-checkbox">
                        <input type="radio" asp-for="Input.Scope"
                               value="@((int)UpsertModel.ApplyScope.SingleGrade)"
                               id="scopeSingle" />
                        <span>One grade</span>
                    </label>

                    <label class="right-checkbox">
                        <input type="radio" asp-for="Input.Scope"
                               value="@((int)UpsertModel.ApplyScope.GradeLevel)"
                               id="scopeLevel" />
                        <span>All grades in a level</span>
                    </label>

                    <label class="right-checkbox">
                        <input type="radio" asp-for="Input.Scope"
                               value="@((int)UpsertModel.ApplyScope.Everyone)"
                               id="scopeEveryone" />
                        <span>Everyone — all @Model.TotalGradeCount grades in the system</span>
                    </label>
                </div>
            }

            <div class="form-grid-2 form-grid-2-spaced">

                <!-- Grade (Scope = SingleGrade) -->
                <div class="form-group" id="gradeWrapper">
                    <label class="form-label" asp-for="Input.GradeId">
                        Grade <span class="required">*</span>
                    </label>
                    <select asp-for="Input.GradeId" asp-items="Model.Grades"
                            class="form-control" id="gradeSelect">
                        <option value="">— Select grade —</option>
                    </select>
                    <span asp-validation-for="Input.GradeId" class="text-danger"></span>
                </div>

                <!-- Grade Level (Scope = GradeLevel) -->
                <div class="form-group is-hidden" id="levelWrapper">
                    <label class="form-label" asp-for="Input.GradeLevelId">
                        Grade Level <span class="required">*</span>
                    </label>
                    <select asp-for="Input.GradeLevelId" asp-items="Model.GradeLevels"
                            class="form-control" id="levelSelect">
                        <option value="">— Select level —</option>
                    </select>
                    <span asp-validation-for="Input.GradeLevelId" class="text-danger"></span>
                </div>

                <!-- Bulk info (Scope = GradeLevel or Everyone) -->
                <div class="form-group full-width is-hidden" id="bulkInfoWrapper">
                    <div class="bulk-info">
                        <i class="fa-solid fa-circle-info bulk-info-icon"></i>
                        <span id="bulkInfoText"></span>
                    </div>
                </div>

                <!-- Term -->
                <div class="form-group">
                    <label class="form-label" asp-for="Input.TermId">
                        Term <span class="required">*</span>
                    </label>
                    <select asp-for="Input.TermId" asp-items="Model.Terms"
                            class="form-control" required>
                        <option value="">— Select term —</option>
                    </select>
                    <span asp-validation-for="Input.TermId" class="text-danger"></span>
                </div>

                <!-- Levy Type -->
                <div class="form-group">
                    <label class="form-label" asp-for="Input.LevyTypeId">
                        Levy Type <span class="required">*</span>
                    </label>
                    <select asp-for="Input.LevyTypeId" asp-items="Model.LevyTypes"
                            class="form-control" required>
                        <option value="">— Select levy type —</option>
                    </select>
                    <span asp-validation-for="Input.LevyTypeId" class="text-danger"></span>
                </div>

                <!-- Currency (read-only) -->
                <div class="form-group">
                    <label class="form-label">Currency</label>
                    <input type="text"
                           class="form-control"
                           value="@Model.BaseCurrency — base currency"
                           readonly />
                    <small class="currency-hint">
                        All fees are quoted in the base currency.
                    </small>
                </div>

                <!-- Amount -->
                <div class="form-group">
                    <label class="form-label" asp-for="Input.Amount">
                        Amount <span class="required">*</span>
                    </label>
                    <input asp-for="Input.Amount"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control"
                           placeholder="0.00"
                           required />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>

            </div>
        </div>

        <div class="card-footer">
            @if (Model.IsEditing)
            {
                <a asp-page="./Upsert" class="btn btn-secondary">Cancel</a>
            }
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i>
                <span id="submitLabel">@(Model.IsEditing ? "Save Changes" : "Add Fee")</span>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (!Model.IsEditing)
    {
        <script>
            (function () {
                const scopeSingle   = document.getElementById('scopeSingle');
                const scopeLevel    = document.getElementById('scopeLevel');
                const scopeEveryone = document.getElementById('scopeEveryone');

                const gradeWrap  = document.getElementById('gradeWrapper');
                const levelWrap  = document.getElementById('levelWrapper');
                const bulkInfo   = document.getElementById('bulkInfoWrapper');
                const bulkText   = document.getElementById('bulkInfoText');

                const gradeSelect = document.getElementById('gradeSelect');
                const levelSelect = document.getElementById('levelSelect');
                const submitLabel = document.getElementById('submitLabel');

                // Total grades per level — read from the server-rendered dropdown
                const levelLabels = {};
                Array.from(levelSelect.options).forEach(o => {
                    if (o.value) levelLabels[o.value] = o.text;
                });

                if (!scopeSingle) return;

                function show(el) { el.classList.remove('is-hidden'); }
                function hide(el) { el.classList.add('is-hidden'); }

                function sync() {
                    const s = document.querySelector('input[name="Input.Scope"]:checked');
                    if (!s) return;

                    const value = parseInt(s.value, 10);

                    // Reset visibility
                    hide(gradeWrap);
                    hide(levelWrap);
                    hide(bulkInfo);

                    if (gradeSelect) gradeSelect.required = false;
                    if (levelSelect) levelSelect.required = false;

                    if (value === 0) {
                        // One grade
                        show(gradeWrap);
                        if (gradeSelect) gradeSelect.required = true;
                        submitLabel.textContent = 'Add Fee';
                    }
                    else if (value === 1) {
                        // Grade level
                        show(levelWrap);
                        if (levelSelect) levelSelect.required = true;
                        bulkText.innerHTML = 'The fee will be created for <strong>all grades</strong> in the selected level. ' +
                                             'Grades that already have this fee for the selected term and levy type will be skipped.';
                        show(bulkInfo);
                        submitLabel.textContent = 'Add Fee to Level';
                    }
                    else {
                        // Everyone
                        bulkText.innerHTML = 'The fee will be created for <strong>all @Model.TotalGradeCount grade(s)</strong> in the system. ' +
                                             'Grades that already have this fee for the selected term and levy type will be skipped.';
                        show(bulkInfo);
                        submitLabel.textContent = 'Add Fee to All Grades';
                    }
                }

                scopeSingle.addEventListener('change', sync);
                scopeLevel.addEventListener('change', sync);
                scopeEveryone.addEventListener('change', sync);

                sync();
            })();
        </script>
    }
}