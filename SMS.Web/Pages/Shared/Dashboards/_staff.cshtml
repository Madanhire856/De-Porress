@model SMS.Web.Pages.IndexModel
@using SMS.Lib
<div class="admin-dashboard teacher-dashboard">
    <header class="admin-heading"><div><span class="admin-eyebrow">TEACHING WORKSPACE</span><h1>Teacher overview<span>.</span></h1><p>Welcome, @Model.DisplayName. Your classes and teaching tools in one place.</p></div><div class="admin-date">@Model.SchoolToday.ToString("dd MMM yyyy")</div></header>
    @if (Model.Can(AccessRights.ViewTerms))
    {
        <section class="admin-term"><i class="fas fa-graduation-cap" aria-hidden="true"></i><div><span class="admin-eyebrow">CURRENT TERM</span><h2>@(Model.CurrentTerm == null ? "No current term configured" : $"{Model.CurrentTerm.Name} · {Model.CurrentTerm.AcademicYear}")</h2></div><a asp-area="Config" asp-page="/Terms/Index">View terms →</a></section>
    }
    <div class="admin-columns">
        @if (Model.Can(AccessRights.ViewClasses))
        {
            <section class="admin-panel"><header><div><h2>My classes</h2><p>Classes assigned to your linked staff record</p></div></header>
                @if (Model.TeacherClasses.Count == 0)
                {
                    <div class="admin-empty"><i class="fas fa-school" aria-hidden="true"></i><h3>No class assigned yet</h3><p>Your administrator can link your user account to your staff record and assign your class.</p></div>
                }
                else
                {
                    <div class="admin-actions">@foreach (var classroom in Model.TeacherClasses) { <a asp-area="Config" asp-page="/Classes/Details" asp-route-id="@classroom.Id"><i class="fas fa-school" aria-hidden="true"></i><span>@classroom.Name<small>@classroom.Grade @if (classroom.Students.HasValue) { <text>· @classroom.Students active students</text> }</small></span><b>›</b></a> }</div>
                }
            </section>
        }
        <section class="admin-panel"><header><div><h2>Teaching tools</h2><p>Available according to your account rights</p></div><i class="fas fa-bolt" aria-hidden="true"></i></header>
            <div class="admin-actions">@foreach (var link in Model.WorkspaceLinks) { <a asp-area="@link.Area" asp-page="@link.Page"><i class="fas @link.Icon" aria-hidden="true"></i><span>@link.Title<small>@link.Group</small></span><b>›</b></a> }</div>
            @if (!Model.WorkspaceLinks.Any()) { <div class="admin-empty"><p>No teaching tools are assigned. Ask your administrator to review your user group rights.</p></div> }
        </section>
    </div>
@if (Model.Can(SMS.Lib.AccessRights.ViewLearners)) { @await Html.PartialAsync("~/Pages/Shared/Dashboards/_enrolments.cshtml", Model) }
<footer class="admin-footer">St. Martin De Porres <span>School Management System · Teacher workspace</span></footer>
</div>

