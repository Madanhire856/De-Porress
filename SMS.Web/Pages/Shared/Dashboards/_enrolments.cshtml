@model SMS.Web.Pages.IndexModel
@using System.Globalization
<section class="admin-panel dashboard-report"><header><div><h2>Recent enrolments · last 7 days</h2><p>@Model.ReportingStart.ToString("dd MMM") – @Model.SchoolToday.ToString("dd MMM yyyy") · @(Model.IsTeacher ? "Your assigned classes" : "School-wide") · @Model.RecentEnrolmentCount enrolments</p></div></header>
@if (Model.RecentEnrolments.Count == 0) { <div class="admin-empty"><i class="fas fa-user-graduate" aria-hidden="true"></i><h3>No enrolments in this period</h3><p>Students with an enrolment date in the last seven days will appear here.</p></div> }
else { <div class="dashboard-table-wrap"><table class="dashboard-table"><caption class="visually-hidden">Latest student enrolments in the last seven days</caption><thead><tr><th scope="col">Student</th><th scope="col">Class</th><th scope="col">Enrolment date</th></tr></thead><tbody>@foreach (var student in Model.RecentEnrolments) { <tr><td><a asp-area="Academics" asp-page="/Students/Details" asp-route-id="@student.Id">@student.Name</a></td><td>@student.Class</td><td class="dashboard-nowrap">@(student.Date?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture))</td></tr> }</tbody></table></div><p class="admin-note">Showing the latest 10 enrolments at most, based on enrolment dates.</p> }</section>
