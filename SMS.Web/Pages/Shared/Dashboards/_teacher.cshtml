@model SMS.Web.Pages.IndexModel
@using SMS.Lib
@using System.Globalization
@{ var tools = Model.WorkspaceLinks.ToList(); }
<div class="admin-dashboard teacher-dashboard">
    <header class="admin-heading"><div><span class="admin-eyebrow">MY TEACHING SUMMARY</span><h1>Dashboard</h1><p>Welcome, @Model.DisplayName. Your classes, student accounts and school assignments.</p></div><div class="admin-date"><i class="far fa-calendar-alt" aria-hidden="true"></i><span>@Model.SchoolToday.ToString("dddd, dd MMMM yyyy", CultureInfo.InvariantCulture)</span></div></header>
    @if (!Model.TeacherStaffLinked) { <div class="admin-empty"><h3>Your staff record is not linked</h3><p>Ask your administrator to link this account to your staff record so your class and activity summaries can appear.</p></div> }
    <section class="admin-term" aria-label="Current term"><i class="fas fa-graduation-cap" aria-hidden="true"></i><div><span class="admin-eyebrow">CURRENT TERM</span><h2>@(Model.CurrentTerm == null ? "No current term configured" : $"{Model.CurrentTerm.Name} · {Model.CurrentTerm.AcademicYear}")</h2><p>@(Model.CurrentTerm == null ? "Fee status is unavailable until a current term is configured." : $"{Model.CurrentTerm.StartDate:dd MMM} – {Model.CurrentTerm.EndDate:dd MMM yyyy}")</p></div>@if (Model.CanOpen("Config", "/Terms/Index")) { <a asp-area="Config" asp-page="/Terms/Index">View calendar →</a> }</section>
    <section class="admin-stats teacher-summary-stats" aria-label="Your class and current term fees">
        <div class="admin-stat"><div>Students in my classes<i class="fas fa-user-graduate" aria-hidden="true"></i></div><strong>@Model.TeacherActiveStudents.ToString("N0")</strong><p>@Model.TeacherClasses.Count assigned classes · active students</p></div>
        <div class="admin-stat"><div>Paid-up students<i class="fas fa-circle-check" aria-hidden="true"></i></div><strong>@(Model.CurrentTerm == null ? "—" : Model.TeacherPaidUpStudents.ToString("N0"))</strong><p>Current-term accounts with no balance owing</p></div>
        <div class="admin-stat"><div>Students owing fees<i class="fas fa-wallet" aria-hidden="true"></i></div><strong>@(Model.CurrentTerm == null ? "—" : Model.TeacherStudentsOwing.ToString("N0"))</strong><p>At least one outstanding current-term account</p></div>
        <div class="admin-stat"><div>No fee account<i class="fas fa-file-circle-question" aria-hidden="true"></i></div><strong>@(Model.CurrentTerm == null ? "—" : Model.TeacherStudentsWithoutAccount.ToString("N0"))</strong><p>Current-term account not yet created</p></div>
    </section>
    <div class="admin-columns">
        <section class="admin-panel"><header><div><h2>My class summary</h2><p>Assigned classes and active student totals</p></div></header>
        @if (Model.TeacherClasses.Count == 0) { <div class="admin-empty"><h3>No classes assigned</h3><p>Your administrator can assign classes to your linked staff record.</p></div> }
        else { <div class="dashboard-table-wrap"><table class="data-table table-compact"><caption class="visually-hidden">Your assigned class summary</caption><thead><tr><th>Class</th><th>Grade</th><th class="dashboard-number">Students</th></tr></thead><tbody>@foreach (var classroom in Model.TeacherClasses) { <tr><td>@if (Model.CanOpen("Config", "/Classes/Index")) { <a asp-area="Config" asp-page="/Classes/Details" asp-route-id="@classroom.Id">@classroom.Name</a> } else { @classroom.Name }</td><td>@classroom.Grade</td><td class="dashboard-number">@classroom.Students?.ToString("N0")</td></tr> }</tbody></table></div> }
        <p class="admin-note">Attendance recorded today: <strong>@Model.TeacherAttendanceRecorded of @Model.TeacherActiveStudents students</strong>.</p>
        <p class="admin-note">Assigned subjects: @(Model.TeacherSubjects.Count == 0 ? "None assigned" : string.Join(", ", Model.TeacherSubjects)).</p>
        </section>
        <section class="admin-panel"><header><div><h2>Outstanding class fees</h2><p>Active students in your classes · current term</p></div></header>
        @if (Model.CurrentTerm == null) { <div class="admin-empty"><p>No current term configured.</p></div> }
        else if (Model.TeacherBalances.Count == 0) { <div class="admin-empty"><h3>No outstanding balances recorded</h3><p>@Model.TeacherStudentsWithoutAccount students still have no current-term fee account.</p></div> }
        else { <div class="dashboard-table-wrap"><table class="data-table table-compact"><caption class="visually-hidden">Outstanding class fees by currency</caption><thead><tr><th>Currency</th><th class="dashboard-number">Outstanding</th></tr></thead><tbody>@foreach (var balance in Model.TeacherBalances) { <tr><td>@balance.Currency</td><td class="dashboard-number">@balance.Amount.ToString("N2")</td></tr> }</tbody></table></div> }
        <p class="admin-note">Amounts remain separate by currency. Students without accounts are not counted as paid up.</p>
        </section>
    </div>
    <div class="admin-columns teacher-activity-panels">
        <section class="admin-panel"><header><div><h2>School houses</h2><p>@Model.TeacherHouses.Count houses · @Model.TeacherHouses.Count(house => house.Assigned) assigned to you</p></div>@if (Model.CanOpen("Sports", "/Houses/Index")) { <a asp-area="Sports" asp-page="/Houses/Index">View houses →</a> }</header>
        @if (Model.TeacherHouses.Count == 0) { <div class="admin-empty"><p>No school houses configured.</p></div> }
        else { <div class="dashboard-table-wrap"><table class="data-table table-compact"><caption class="visually-hidden">All school houses and your assignments</caption><thead><tr><th>House</th><th>Your assignment</th></tr></thead><tbody>@foreach (var house in Model.TeacherHouses) { <tr><td>@house.Name</td><td>@(house.Assigned ? "Assigned to you" : "Not assigned")</td></tr> }</tbody></table></div> }
        </section>
        <section class="admin-panel"><header><div><h2>School sports</h2><p>@Model.TeacherSports.Count sports · @Model.TeacherSports.Count(sport => sport.Assigned) assigned to you</p></div>@if (Model.CanOpen("Sports", "/Sporting/Index")) { <a asp-area="Sports" asp-page="/Sporting/Index">View sports →</a> }</header>
        @if (Model.TeacherSports.Count == 0) { <div class="admin-empty"><p>No school sports configured.</p></div> }
        else { <div class="dashboard-table-wrap"><table class="data-table table-compact"><caption class="visually-hidden">All school sports and your assignments</caption><thead><tr><th>Sport</th><th>Your assignment</th></tr></thead><tbody>@foreach (var sport in Model.TeacherSports) { <tr><td>@sport.Name</td><td>@(sport.Assigned ? "Assigned to you" : "Not assigned")</td></tr> }</tbody></table></div> }
        </section>
    </div>
    <section class="admin-panel dashboard-report"><header><div><h2>Upcoming school Masses</h2><p>@Model.UpcomingMassCount upcoming · @Model.AssignedMassCount involving you or your class students</p></div>@if (Model.CanOpen("Faith", "/Masses/Index")) { <a asp-area="Faith" asp-page="/Masses/Index">View Mass timetable →</a> }</header>
    @if (Model.TeacherMasses.Count == 0) { <div class="admin-empty"><p>No upcoming Masses scheduled.</p></div> }
    else { <div class="dashboard-table-wrap"><table class="data-table table-compact"><caption class="visually-hidden">Next five school Masses and related assignments</caption><thead><tr><th>Date and time</th><th>Venue</th><th>Celebrant</th><th>Your assignment</th><th class="dashboard-number">Your students on roster</th></tr></thead><tbody>@foreach (var mass in Model.TeacherMasses) { <tr><td class="dashboard-nowrap">@mass.Date.ToString("dd MMM yyyy HH:mm")</td><td>@mass.Venue</td><td>@mass.Celebrant</td><td>@(mass.Assigned ? "On the roster" : "Not on the roster")</td><td class="dashboard-number">@mass.ClassParticipants</td></tr> }</tbody></table></div><p class="admin-note">Showing the next five school Masses at most. Student counts refer to active students in your assigned classes.</p> }
    </section>
    @if (Model.Can(AccessRights.ViewLearners)) { @await Html.PartialAsync("~/Pages/Shared/Dashboards/_enrolments.cshtml", Model) }
    <section class="admin-panel dashboard-report"><header><div><h2>Teaching tools</h2><p>Shortcuts available to your account</p></div></header>
    @if (tools.Count == 0) { <div class="admin-empty"><p>No additional tools assigned. Your class and activity summaries remain available above.</p></div> }
    else { <div class="admin-actions">@foreach (var link in tools) { <a asp-area="@link.Area" asp-page="@link.Page"><i class="fas @link.Icon" aria-hidden="true"></i><span>@link.Title<small>@link.Group</small></span><b aria-hidden="true">›</b></a> }</div> }
    </section>
    <footer class="admin-footer">St. Martin De Porres <span>School Management System · Teacher workspace</span></footer>
</div>
