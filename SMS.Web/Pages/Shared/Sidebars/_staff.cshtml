@using System.Security.Claims
@using SMS.Lib
@using SMS.Web.Services
@inject ICurrentUserService CurrentUser
@inject WorkspaceAccess Access
@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isDashboard = currentArea == "" && currentPage.Equals("/Index", StringComparison.OrdinalIgnoreCase);
    var currentDisplayName = CurrentUser.Name ?? User.FindFirstValue(ClaimTypes.Name) ?? "Staff";
    var currentRoleName = Access.Name;
    var initialMarker = currentDisplayName.Length > 0 ? currentDisplayName[..1].ToUpperInvariant() : "U";
    var groups = Access.Navigation.GroupBy(f => f.Group).ToList();
}
<div class="sidebar-wrapper">
    <div class="sidebar-header"><img class="logo" src="~/Images/logo.jpeg" alt="School crest" /><h6 class="school-name">St. Martin De Porres</h6></div>
    <div class="sidebar-top"><div class="sidebar-menu">
        @if (Access.CanViewDashboard)
        {
            <a asp-area="" asp-page="/Index" class="sidebar-link @(isDashboard ? "active" : "")"><i class="fas fa-tachometer-alt" aria-hidden="true"></i><span>@Access.Name dashboard</span></a>
        }
        @foreach (var group in groups)
        {
            var id = "workspaceMenu" + groups.IndexOf(group);
            var active = group.Any(f => f.Area.Equals(currentArea, StringComparison.OrdinalIgnoreCase)
                && currentPage.StartsWith(f.Page[..(f.Page.LastIndexOf('/') + 1)], StringComparison.OrdinalIgnoreCase));
            <div class="sidebar-dropdown">
                <a class="sidebar-dropdown-toggle @(active ? "active" : "")" data-bs-toggle="collapse" href="#@id" role="button" aria-expanded="@(active ? "true" : "false")" aria-controls="@id"><div class="left-side"><i class="fas @group.First().Icon main-icon" aria-hidden="true"></i><span>@group.Key</span></div><i class="fas fa-chevron-down chevron" aria-hidden="true"></i></a>
                <div class="collapse @(active ? "show" : "")" id="@id"><div class="sidebar-submenu">
                    @foreach (var item in group)
                    {
                        var selected = item.Area.Equals(currentArea, StringComparison.OrdinalIgnoreCase) && item.Page.Equals(currentPage, StringComparison.OrdinalIgnoreCase);
                        <a asp-area="@item.Area" asp-page="@item.Page" class="sidebar-sublink @(selected ? "active" : "")">@item.Title</a>
                    }
                </div></div>
            </div>
        }
        @if (groups.Count == 0)
        {
            <p class="sidebar-access-note">No modules are assigned to this account. Contact your administrator.</p>
        }
    </div></div>
    <!-- USER PROFILE + LOGOUT DROPDOWN -->
    <div class="sidebar-bottom">
        <div class="dropdown dropup w-100">

            <div class="sidebar-user" data-bs-toggle="dropdown" aria-expanded="false" role="button">
                <div class="sidebar-avatar">@initialMarker</div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">@currentDisplayName</div>
                    <div class="sidebar-user-role">@currentRoleName</div>
                </div>
                <i class="fas fa-chevron-up sidebar-user-chevron"></i>
            </div>

            <ul class="dropdown-menu sidebar-user-menu">
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="fas fa-user-circle"></i>
                        <span>My Profile</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="fas fa-key"></i>
                        <span>Change Password</span>
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form method="post" asp-area="Identity"
                          asp-page="/Account/Logout" class="m-0">
                        <button type="submit" class="dropdown-item">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</div>
