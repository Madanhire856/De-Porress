@* Pages/Shared/SideBars/_staff.cshtml *@
@using System.Security.Claims

@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString()?.ToLower() ?? "";
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString()?.ToLower() ?? "";

    // Dashboard
    var isDashboard = string.IsNullOrEmpty(currentArea) && (currentPage == "/index" || currentPage.StartsWith("/dashboard"));

    // Academics Group (top-level) — people & activities only
    var isStaff = currentPage.StartsWith("/staff");
    var isStudents = currentPage.StartsWith("/students");
    var isTimetable = currentPage.StartsWith("/timetable");
    var isPrefects = currentPage.StartsWith("/prefects");
    var isAcademicsSection = isStaff || isStudents || isTimetable || isPrefects;

    // Finance Group (top-level)
    var isFees = currentPage.StartsWith("/fees");
    var isProjects = currentPage.StartsWith("/projects");
    var isFinanceSection = isFees || isProjects;

    // Faith Group (top-level)
    var isMass = currentPage.StartsWith("/mass");

    // Sports (top-level)
    var isSports = currentPage.StartsWith("/sports");

    // ============================================================
    //  CONFIGURATION SUB-FLAGS
    // ============================================================
    var isUsers = currentPage.StartsWith("/users");
    var isUserGroups = currentPage.StartsWith("/usergroups");
    var isEmails = currentPage.StartsWith("/emails");
    var isMessageTemplates = currentPage.StartsWith("/messagetemplates");

    // -- Nested subgroup: Academic Setup --
    var isGrades = currentPage.StartsWith("/grades");
    var isClasses = currentPage.StartsWith("/classes");
    var isSubjects = currentPage.StartsWith("/subjects");
    var isTerms = currentPage.StartsWith("/terms");
    var isAcademicSetup =
        isGrades || isClasses || isSubjects || isTerms;

    // -- Nested subgroup: Location & Groups --
    var isHouses = currentPage.StartsWith("/houses");
    var isVillages = currentPage.StartsWith("/villages");
    var isLocationGroups =
        isHouses || isVillages;

    // -- Nested subgroup: Finance Setup --
    var isCurrencies = currentPage.StartsWith("/currency");
    var isFinanceSetup =
        isCurrencies;

    // -- Configuration is active if any child is active --
    var isConfigSection =
        isUsers || isUserGroups || isEmails || isMessageTemplates ||
        isAcademicSetup || isLocationGroups || isFinanceSetup ||
        isSports; // Sports page lives in Config area

    var currentDisplayName = User.FindFirstValue(ClaimTypes.Name) ?? "Head Teacher";
    var initialMarker = currentDisplayName.Length >= 1 ? currentDisplayName.Substring(0, 1).ToUpper() : "U";
    var currentEmail = User.FindFirstValue("preferred_username")
                       ?? User.FindFirstValue(ClaimTypes.Email)
                       ?? "";
}

<div class="sidebar-wrapper">
    <!-- FIXED HEADER -->
    <div class="sidebar-header">
        <img class="logo" src="~/images/logo.jpeg" alt="Logo" />
        <h6 class="school-name">St. Martin De Porres</h6>
    </div>

    <div class="sidebar-top">
        <div class="sidebar-menu">

            <!-- Dashboard -->
            <a asp-area="" asp-page="/Index" class="sidebar-link @(isDashboard ? "active" : "")">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>

            <!-- ACADEMICS DROPDOWN -->
            <div class="sidebar-dropdown">
                <a class="sidebar-dropdown-toggle @(isAcademicsSection ? "active" : "")"
                   data-bs-toggle="collapse" href="#academicsMenu" role="button"
                   aria-expanded="@(isAcademicsSection ? "true" : "false")" aria-controls="academicsMenu">
                    <div class="left-side">
                        <i class="fas fa-graduation-cap main-icon"></i>
                        <span>Academics</span>
                    </div>
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @(isAcademicsSection ? "show" : "")" id="academicsMenu">
                    <div class="sidebar-submenu">
                        <a asp-area="" asp-page="/Students/Index" class="sidebar-sublink @(isStudents ? "active" : "")">Students</a>
                        <a asp-area="Academics" asp-page="/Staff/Index" class="sidebar-sublink @(isStaff ? "active" : "")">Staff</a>
                        <a asp-area="" asp-page="/Timetable/Index" class="sidebar-sublink @(isTimetable ? "active" : "")">Timetable</a>
                        <a asp-area="" asp-page="/Prefects/Index" class="sidebar-sublink @(isPrefects ? "active" : "")">Prefects</a>
                    </div>
                </div>
            </div>

            <!-- FINANCE DROPDOWN -->
            <div class="sidebar-dropdown">
                <a class="sidebar-dropdown-toggle @(isFinanceSection ? "active" : "")"
                   data-bs-toggle="collapse" href="#financeMenu" role="button"
                   aria-expanded="@(isFinanceSection ? "true" : "false")" aria-controls="financeMenu">
                    <div class="left-side">
                        <i class="fas fa-hand-holding-usd main-icon"></i>
                        <span>Finance</span>
                    </div>
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @(isFinanceSection ? "show" : "")" id="financeMenu">
                    <div class="sidebar-submenu">
                        <a asp-area="" asp-page="/Fees/Index" class="sidebar-sublink @(isFees ? "active" : "")">Fees</a>
                        <a asp-area="" asp-page="/Projects/Index" class="sidebar-sublink @(isProjects ? "active" : "")">Sponsorship</a>
                    </div>
                </div>
            </div>

            <!-- FAITH DROPDOWN -->
            <div class="sidebar-dropdown">
                <a class="sidebar-dropdown-toggle @(isMass ? "active" : "")"
                   data-bs-toggle="collapse" href="#faithMenu" role="button"
                   aria-expanded="@(isMass ? "true" : "false")" aria-controls="faithMenu">
                    <div class="left-side">
                        <i class="fas fa-church main-icon"></i>
                        <span>Faith</span>
                    </div>
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @(isMass ? "show" : "")" id="faithMenu">
                    <div class="sidebar-submenu">
                        <a asp-area="" asp-page="/Mass/Index" class="sidebar-sublink @(isMass ? "active" : "")">Mass & Liturgy</a>
                    </div>
                </div>
            </div>

            <!-- SPORTS DROPDOWN -->
            <div class="sidebar-dropdown">
                <a class="sidebar-dropdown-toggle @(isSports ? "active" : "")"
                   data-bs-toggle="collapse" href="#sportsMenu" role="button"
                   aria-expanded="@(isSports ? "true" : "false")" aria-controls="sportsMenu">
                    <div class="left-side">
                        <i class="fas fa-futbol main-icon"></i>
                        <span>Sports</span>
                    </div>
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @(isSports ? "show" : "")" id="sportsMenu">
                    <div class="sidebar-submenu">
                        <a asp-area="" asp-page="/Sports/Index" class="sidebar-sublink @(isSports ? "active" : "")">Sports</a>
                    </div>
                </div>
            </div>

            <!-- ==========================================================
                 CONFIGURATION DROPDOWN
                 ========================================================== -->
            <div class="sidebar-dropdown">
                <a class="sidebar-dropdown-toggle @(isConfigSection ? "active" : "")"
                   data-bs-toggle="collapse" href="#configMenu" role="button"
                   aria-expanded="@(isConfigSection ? "true" : "false")" aria-controls="configMenu">
                    <div class="left-side">
                        <i class="fas fa-cog main-icon"></i>
                        <span>Configuration</span>
                    </div>
                    <i class="fas fa-chevron-down chevron"></i>
                </a>
                <div class="collapse @(isConfigSection ? "show" : "")" id="configMenu">
                    <div class="sidebar-submenu">

                        <!-- --- Access Control --- -->
                        <a asp-area="Config" asp-page="/Users/Index" class="sidebar-sublink @(isUsers ? "active" : "")">Users</a>
                        <a asp-area="Config" asp-page="/UserGroups/Index" class="sidebar-sublink @(isUserGroups ? "active" : "")">User Groups</a>

                        <div class="sidebar-divider"></div>

                        <!-- --- Academic Setup (nested) --- -->
                        <div class="sidebar-subgroup">
                            <a class="sidebar-subgroup-toggle @(isAcademicSetup ? "active" : "")"
                               data-bs-toggle="collapse" href="#academicSetupMenu" role="button"
                               aria-expanded="@(isAcademicSetup ? "true" : "false")" aria-controls="academicSetupMenu">
                                <i class="fas fa-chevron-right subgroup-chevron"></i>
                                <span>Academic Setup</span>
                            </a>
                            <div class="collapse @(isAcademicSetup ? "show" : "")" id="academicSetupMenu">
                                <a asp-area="Config" asp-page="/Grades/Index" class="sidebar-sublink @(isGrades ? "active" : "")">Grades</a>
                                <a asp-area="Config" asp-page="/Classes/Index" class="sidebar-sublink @(isClasses ? "active" : "")">Classes</a>
                                <a asp-area="Config" asp-page="/Subjects/Index" class="sidebar-sublink @(isSubjects ? "active" : "")">Subjects</a>
                                <a asp-area="Config" asp-page="/Terms/Index" class="sidebar-sublink @(isTerms ? "active" : "")">Terms</a>
                            </div>
                        </div>

                        <div class="sidebar-divider"></div>

                        <!-- --- Location & Groups (nested) --- -->
                        <div class="sidebar-subgroup">
                            <a class="sidebar-subgroup-toggle @(isLocationGroups ? "active" : "")"
                               data-bs-toggle="collapse" href="#locationGroupsMenu" role="button"
                               aria-expanded="@(isLocationGroups ? "true" : "false")" aria-controls="locationGroupsMenu">
                                <i class="fas fa-chevron-right subgroup-chevron"></i>
                                <span>Location &amp; Groups</span>
                            </a>
                            <div class="collapse @(isLocationGroups ? "show" : "")" id="locationGroupsMenu">
                                <a asp-area="Config" asp-page="/Houses/Index" class="sidebar-sublink @(isHouses ? "active" : "")">Houses</a>
                                <a asp-area="Config" asp-page="/Villages/Index" class="sidebar-sublink @(isVillages ? "active" : "")">Villages</a>
                            </div>
                        </div>

                        <div class="sidebar-divider"></div>

                        <!-- --- Finance Setup (nested) --- -->
                        <div class="sidebar-subgroup">
                            <a class="sidebar-subgroup-toggle @(isFinanceSetup ? "active" : "")"
                               data-bs-toggle="collapse" href="#financeSetupMenu" role="button"
                               aria-expanded="@(isFinanceSetup ? "true" : "false")" aria-controls="financeSetupMenu">
                                <i class="fas fa-chevron-right subgroup-chevron"></i>
                                <span>Finance Setup</span>
                            </a>
                            <div class="collapse @(isFinanceSetup ? "show" : "")" id="financeSetupMenu">
                                <a asp-area="Config" asp-page="/Currency/Index" class="sidebar-sublink @(isCurrencies ? "active" : "")">Currencies</a>
                            </div>
                        </div>

                        <div class="sidebar-divider"></div>

                        <!-- --- Communication --- -->
                        <a asp-area="Config" asp-page="/Emails/Index" class="sidebar-sublink @(isEmails ? "active" : "")">Emails</a>
                        <a asp-area="Config" asp-page="/MessageTemplates/Index" class="sidebar-sublink @(isMessageTemplates ? "active" : "")">Message Templates</a>

                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ============================================================
         USER PROFILE + LOGOUT DROPDOWN
         ============================================================ -->
    <div class="sidebar-bottom">
        <div class="dropdown dropup w-100">

            <div class="sidebar-user" data-bs-toggle="dropdown" aria-expanded="false" role="button">
                <div class="sidebar-avatar">@initialMarker</div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name">@currentDisplayName</div>
                    <div class="sidebar-user-role">Head Teacher</div>
                </div>
                <i class="fas fa-chevron-up sidebar-user-chevron"></i>
            </div>

            <ul class="dropdown-menu sidebar-user-menu">
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="fas fa-user-circle"></i>
                        <span>My Profile</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#">
                        <i class="fas fa-key"></i>
                        <span>Change Password</span>
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form method="post" asp-area="Identity"
                          asp-page="/Account/Logout" class="m-0">
                        <button type="submit" class="dropdown-item">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</div>