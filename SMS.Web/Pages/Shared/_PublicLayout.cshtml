@{
    Layout = "_Layout";
    ViewData["UseFullWidthLayout"] = true;
}
<div class="school-site">
    <a class="school-skip" href="#school-content">Skip to content</a>
    <partial name="_PublicHeader" />
    <main id="school-content">@RenderBody()</main>
    <partial name="_PublicFooter" />
</div>
@section Styles {
    <link rel="stylesheet" href="~/css/school-landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/school-gallery.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}
@section Scripts {
    <script src="~/js/school-landing.js" asp-append-version="true"></script>
    <script src="~/js/school-gallery.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
