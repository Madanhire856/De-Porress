@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var hasPageTitle = ViewData["PageTitle"] != null;
    var hasSubTitle = ViewData["PageSubTitle"] != null;
    var useFullWidthLayout = ViewData["UseFullWidthLayout"] as bool? ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - St Martin De Porres</title>

    <!-- Bootstrap CSS kept for utility classes used in some pages -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/jqueryui/themes/base/jquery-ui.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @if (useFullWidthLayout)
    {
       @*  <!-- ============================================================
             PUBLIC / LANDING / LOGIN LAYOUT
             Full-width, scrollable, no sidebar.
             ============================================================ --> *@
        <div class="public-wrapper">
            @RenderBody()
        </div>
    }
    else
    {
       @*  <!-- ============================================================
             AUTHENTICATED DASHBOARD LAYOUT (Sidebar + Main Content)
             ====================================================@* ======== --> *@
        <div class="app-layout">

           @*  <!-- Hidden Checkbox for CSS-only Sidebar Toggle (mobile) --> *@
            <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-checkbox" />

           @*@ <!-- Mobile Top Bar with Hamburger Menu --> *@
            <div class="mobile-top-bar">
                <label for="sidebar-toggle" class="menu-toggle-btn">
                    <i class="fas fa-bars"></i>
                </label>
                <span class="mobile-brand">St. Martin De Porres</span>
            </div>

           @*  <!-- Overlay (Appears when sidebar is open on mobile) --> *@
            <label for="sidebar-toggle" class="sidebar-overlay"></label>

          @*   <!-- SIDEBAR --> *@
            <aside class="app-sidebar">
                @await Html.PartialAsync("SideBars/_staff")
            </aside>

           @*  <!-- MAIN CONTENT --> *@
            <div class="app-main">
                <main class="app-content">

                   @*  <!-- Page Header & Action Bar --> *@
                    <div class="page-header">
                        <div class="header-text">
                            @if (hasPageTitle)
                            {
                                <h1>@ViewData["PageTitle"]</h1>
                            }
                            @if (hasSubTitle)
                            {
                                <p>@ViewData["PageSubTitle"]</p>
                            }
                        </div>

                        <div class="header-actions">
                            @if (IsSectionDefined("actionbar"))
                            {
                                @RenderSection("actionbar")
                            }
                        </div>
                    </div>

                    @* <!-- Main Body --> *@
                    @RenderBody()

                </main>
            </div>
        </div>
    }

    <script src="~/lib/jqueryui/jquery-ui.js" asp-append-version="true"></script>
    <script src="~/lib/jspdf/jspdf.umd.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jqueryui/jquery-ui.min.js" asp-append-version="true"></script>
        <script src="~/lib/select2/js/select2.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>