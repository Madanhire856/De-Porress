@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var hasPageTitle = ViewData["PageTitle"] != null;
    var hasSubTitle = ViewData["PageSubTitle"] != null;
    var useFullWidthLayout = false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Keep Bootstrap JS for dropdowns, but we are NOT using its CSS for layout -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @if (useFullWidthLayout)
    {
        <!-- PUBLIC / LOGIN LAYOUT -->
        <div class="public-wrapper">
            <main role="main" class="container mt-5">
                @if (hasPageTitle || hasSubTitle)
                {
                    <div class="mb-4 text-center">
                        @if (hasPageTitle)
                        {
                            <h2 class="fw-bold mb-2">@ViewData["PageTitle"]</h2>
                        }
                        @if (hasSubTitle)
                        {
                            <p class="text-muted mb-0">@ViewData["PageSubTitle"]</p>
                        }
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <!-- AUTHENTICATED DASHBOARD LAYOUT (PURE FLEXBOX) -->
        <div class="app-layout">

            <!-- Hidden Checkbox for CSS-only Sidebar Toggle -->
            <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-checkbox" />

            <!-- Mobile Top Bar (Hamburger Menu) -->
            <div class="mobile-top-bar">
                <label for="sidebar-toggle" class="menu-toggle-btn">
                    <i class="fas fa-bars"></i>
                </label>
                <span class="mobile-brand">St. Martin De Porres</span>
            </div>

            <!-- Overlay (Appears when sidebar is open on mobile) -->
            <label for="sidebar-toggle" class="sidebar-overlay"></label>

            <!-- SIDEBAR -->
            <aside class="app-sidebar">
                @await Html.PartialAsync("SideBars/_staff")
            </aside>

            <!-- MAIN CONTENT -->
            <div class="app-main">
                <main class="app-content">

                    <!-- Page Header & Action Bar -->
                    <div class="page-header">
                        <div class="header-text">
                            @if (hasPageTitle)
                            {
                                <h1>@ViewData["PageTitle"]</h1>
                            }
                            @if (hasSubTitle)
                            {
                                <p>@ViewData["PageSubTitle"]</p>
                            }
                        </div>

                        <div class="header-actions">
                            @if (IsSectionDefined("actionbar"))
                            {
                                @RenderSection("actionbar")
                            }
                        </div>
                    </div>

                    <!-- Main Body -->
                    @RenderBody()

                </main>
            </div>
        </div>
    }

    <script src="~/lib/jqueryui/jquery-ui.js" asp-append-version="true"></script>
    <script src="~/lib/jspdf/jspdf.umd.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>