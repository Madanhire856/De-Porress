@model SMS.Web.Pages.Shared.Pagination.PaginationInfo

@{
    var currentPath = Context.Request.PathBase.Add(Context.Request.Path).Value ?? "";

    // Preserve any existing query string (search, filter, etc.) — only swap PageNumber/PageSize
    var existingQuery = Context.Request.Query
        .Where(kvp => !kvp.Key.Equals("PageNumber", StringComparison.OrdinalIgnoreCase)
                   && !kvp.Key.Equals("PageSize", StringComparison.OrdinalIgnoreCase))
        .SelectMany(kvp => kvp.Value.Select(value => new KeyValuePair<string, string?>(kvp.Key, value)))
        .ToList();

    string BuildUrl(int pageNumber)
    {
        if (Model.PageUrl != null) return Model.PageUrl(pageNumber);
        var query = new List<KeyValuePair<string, string?>>(existingQuery) {
            new("PageNumber", pageNumber.ToString()), new("PageSize", Model.PageSize.ToString())
        };
        return currentPath + QueryString.Create(query);
    }
    var totalPages = Math.Max(Model.TotalPages, 1);
    var pages = Enumerable.Range(Math.Max(1, Model.PageNumber - 2),
        Math.Max(0, Math.Min(totalPages, Model.PageNumber + 2) - Math.Max(1, Model.PageNumber - 2) + 1))
        .Append(1).Append(totalPages).Distinct().OrderBy(page => page).ToArray();
    int previous = 0;
}

<div class="table-pagination">
    <nav class="pagination-nav" aria-label="Table pages">
        @if (Model.HasPrevious) {
            <a class="page-link" href="@BuildUrl(Model.PageNumber - 1)" aria-label="Previous page" rel="prev"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
        } else {
            <span class="page-link disabled" aria-disabled="true" aria-label="Previous page"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></span>
        }

        @foreach (var i in pages)
        {
            @if (previous > 0 && i > previous + 1) { <span class="page-link disabled" aria-hidden="true">…</span> }
            <a class="page-link @(i == Model.PageNumber ? "active" : "")"
               href="@BuildUrl(i)" aria-label="Page @i" aria-current="@(i == Model.PageNumber ? "page" : null)">
                @i
            </a>
            previous = i;
        }

        @if (Model.HasNext) {
            <a class="page-link" href="@BuildUrl(Model.PageNumber + 1)" aria-label="Next page" rel="next"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
        } else {
            <span class="page-link disabled" aria-disabled="true" aria-label="Next page"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></span>
        }
    </nav>
</div>
